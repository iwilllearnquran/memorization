[{"verse_key": "80:1", "text": " عَبَسَ وَتَوَلَّىٰٓ"}, {"verse_key": "80:2", "text": "أَن جَآءَهُ ٱلْأَعْمَىٰ"}, {"verse_key": "80:3", "text": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ"}, {"verse_key": "80:4", "text": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ"}, {"verse_key": "80:5", "text": "أَمَّا مَنِ ٱسْتَغْنَىٰ"}, {"verse_key": "80:6", "text": "فَأَنتَ لَهُۥ تَصَدَّىٰ"}, {"verse_key": "80:7", "text": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"}, {"verse_key": "80:8", "text": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ"}, {"verse_key": "80:9", "text": "وَهُوَ يَخْشَىٰ"}, {"verse_key": "80:10", "text": "فَأَنتَ عَنْهُ تَلَهَّىٰ"}, {"verse_key": "80:11", "text": "كَلَّآ إِنَّهَا تَذْكِرَةٌ"}, {"verse_key": "80:12", "text": "فَمَن شَآءَ ذَكَرَهُۥ"}, {"verse_key": "80:13", "text": "فِى صُحُفٍ مُّكَرَّمَةٍ"}, {"verse_key": "80:14", "text": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ"}, {"verse_key": "80:15", "text": "بِأَيْدِى سَفَرَةٍ"}, {"verse_key": "80:16", "text": "كِرَامٍۭ بَرَرَةٍ"}, {"verse_key": "80:17", "text": "قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ"}, {"verse_key": "80:18", "text": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ"}, {"verse_key": "80:19", "text": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"}, {"verse_key": "80:20", "text": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ"}, {"verse_key": "80:21", "text": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ"}, {"verse_key": "80:22", "text": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ"}, {"verse_key": "80:23", "text": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ"}, {"verse_key": "80:24", "text": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ"}, {"verse_key": "80:25", "text": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا"}, {"verse_key": "80:26", "text": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا"}, {"verse_key": "80:27", "text": "فَأَنۢبَتْنَا فِيهَا حَبًّا"}, {"verse_key": "80:28", "text": "وَعِنَبًا وَقَضْبًا"}, {"verse_key": "80:29", "text": "وَزَيْتُونًا وَنَخْلًا"}, {"verse_key": "80:30", "text": "وَحَدَآئِقَ غُلْبًا"}, {"verse_key": "80:31", "text": "وَفَـٰكِهَةً وَأَبًّا"}, {"verse_key": "80:32", "text": "مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ"}, {"verse_key": "80:33", "text": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ"}, {"verse_key": "80:34", "text": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ"}, {"verse_key": "80:35", "text": "وَأُمِّهِۦ وَأَبِيهِ"}, {"verse_key": "80:36", "text": "وَصَـٰحِبَتِهِۦ وَبَنِيهِ"}, {"verse_key": "80:37", "text": "لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ"}, {"verse_key": "80:38", "text": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ"}, {"verse_key": "80:39", "text": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ"}, {"verse_key": "80:40", "text": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ"}, {"verse_key": "80:41", "text": "تَرْهَقُهَا قَتَرَةٌ"}, {"verse_key": "80:42", "text": "أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ"}]