[{"verse_key": "75:1", "text": " لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ"}, {"verse_key": "75:2", "text": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ"}, {"verse_key": "75:3", "text": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"}, {"verse_key": "75:4", "text": "بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ"}, {"verse_key": "75:5", "text": "بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ"}, {"verse_key": "75:6", "text": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ"}, {"verse_key": "75:7", "text": "فَإِذَا بَرِقَ ٱلْبَصَرُ"}, {"verse_key": "75:8", "text": "وَخَسَفَ ٱلْقَمَرُ"}, {"verse_key": "75:9", "text": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ"}, {"verse_key": "75:10", "text": "يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ"}, {"verse_key": "75:11", "text": "كَلَّا لَا وَزَرَ"}, {"verse_key": "75:12", "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ"}, {"verse_key": "75:13", "text": "يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ"}, {"verse_key": "75:14", "text": "بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ"}, {"verse_key": "75:15", "text": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ"}, {"verse_key": "75:16", "text": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ"}, {"verse_key": "75:17", "text": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ"}, {"verse_key": "75:18", "text": "فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ"}, {"verse_key": "75:19", "text": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ"}, {"verse_key": "75:20", "text": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ"}, {"verse_key": "75:21", "text": "وَتَذَرُونَ ٱلْـَٔاخِرَةَ"}, {"verse_key": "75:22", "text": "وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ"}, {"verse_key": "75:23", "text": "إِلَىٰ رَبِّهَا نَاظِرَةٌ"}, {"verse_key": "75:24", "text": "وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ"}, {"verse_key": "75:25", "text": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ"}, {"verse_key": "75:26", "text": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ"}, {"verse_key": "75:27", "text": "وَقِيلَ مَنْ ۜ رَاقٍ"}, {"verse_key": "75:28", "text": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ"}, {"verse_key": "75:29", "text": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"}, {"verse_key": "75:30", "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ"}, {"verse_key": "75:31", "text": "فَلَا صَدَّقَ وَلَا صَلَّىٰ"}, {"verse_key": "75:32", "text": "وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ"}, {"verse_key": "75:33", "text": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ"}, {"verse_key": "75:34", "text": "أَوْلَىٰ لَكَ فَأَوْلَىٰ"}, {"verse_key": "75:35", "text": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ"}, {"verse_key": "75:36", "text": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى"}, {"verse_key": "75:37", "text": "أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ"}, {"verse_key": "75:38", "text": "ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ"}, {"verse_key": "75:39", "text": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"}, {"verse_key": "75:40", "text": "أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ"}]