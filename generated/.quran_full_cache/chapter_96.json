[{"verse_key": "96:1", "text": " ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ"}, {"verse_key": "96:2", "text": "خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ"}, {"verse_key": "96:3", "text": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ"}, {"verse_key": "96:4", "text": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ"}, {"verse_key": "96:5", "text": "عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ"}, {"verse_key": "96:6", "text": "كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ"}, {"verse_key": "96:7", "text": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ"}, {"verse_key": "96:8", "text": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ"}, {"verse_key": "96:9", "text": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ"}, {"verse_key": "96:10", "text": "عَبْدًا إِذَا صَلَّىٰٓ"}, {"verse_key": "96:11", "text": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ"}, {"verse_key": "96:12", "text": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ"}, {"verse_key": "96:13", "text": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ"}, {"verse_key": "96:14", "text": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ"}, {"verse_key": "96:15", "text": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ"}, {"verse_key": "96:16", "text": "نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ"}, {"verse_key": "96:17", "text": "فَلْيَدْعُ نَادِيَهُۥ"}, {"verse_key": "96:18", "text": "سَنَدْعُ ٱلزَّبَانِيَةَ"}, {"verse_key": "96:19", "text": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩"}]