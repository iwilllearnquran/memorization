[{"verse_key": "91:1", "text": " وَٱلشَّمْسِ وَضُحَىٰهَا"}, {"verse_key": "91:2", "text": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا"}, {"verse_key": "91:3", "text": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا"}, {"verse_key": "91:4", "text": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا"}, {"verse_key": "91:5", "text": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا"}, {"verse_key": "91:6", "text": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا"}, {"verse_key": "91:7", "text": "وَنَفْسٍ وَمَا سَوَّىٰهَا"}, {"verse_key": "91:8", "text": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا"}, {"verse_key": "91:9", "text": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا"}, {"verse_key": "91:10", "text": "وَقَدْ خَابَ مَن دَسَّىٰهَا"}, {"verse_key": "91:11", "text": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ"}, {"verse_key": "91:12", "text": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا"}, {"verse_key": "91:13", "text": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا"}, {"verse_key": "91:14", "text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا"}, {"verse_key": "91:15", "text": "وَلَا يَخَافُ عُقْبَـٰهَا"}]