[{"verse_key": "89:1", "text": " وَٱلْفَجْرِ"}, {"verse_key": "89:2", "text": "وَلَيَالٍ عَشْرٍ"}, {"verse_key": "89:3", "text": "وَٱلشَّفْعِ وَٱلْوَتْرِ"}, {"verse_key": "89:4", "text": "وَٱلَّيْلِ إِذَا يَسْرِ"}, {"verse_key": "89:5", "text": "هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ"}, {"verse_key": "89:6", "text": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"}, {"verse_key": "89:7", "text": "إِرَمَ ذَاتِ ٱلْعِمَادِ"}, {"verse_key": "89:8", "text": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَـٰدِ"}, {"verse_key": "89:9", "text": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ"}, {"verse_key": "89:10", "text": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ"}, {"verse_key": "89:11", "text": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَـٰدِ"}, {"verse_key": "89:12", "text": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ"}, {"verse_key": "89:13", "text": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ"}, {"verse_key": "89:14", "text": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ"}, {"verse_key": "89:15", "text": "فَأَمَّا ٱلْإِنسَـٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ"}, {"verse_key": "89:16", "text": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ"}, {"verse_key": "89:17", "text": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ"}, {"verse_key": "89:18", "text": "وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"}, {"verse_key": "89:19", "text": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا"}, {"verse_key": "89:20", "text": "وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا"}, {"verse_key": "89:21", "text": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا"}, {"verse_key": "89:22", "text": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا"}, {"verse_key": "89:23", "text": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ"}, {"verse_key": "89:24", "text": "يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى"}, {"verse_key": "89:25", "text": "فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ"}, {"verse_key": "89:26", "text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ"}, {"verse_key": "89:27", "text": "يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ"}, {"verse_key": "89:28", "text": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً"}, {"verse_key": "89:29", "text": "فَٱدْخُلِى فِى عِبَـٰدِى"}, {"verse_key": "89:30", "text": "وَٱدْخُلِى جَنَّتِى"}]