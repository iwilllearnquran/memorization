[{"verse_key": "105:1", "text": " أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ"}, {"verse_key": "105:2", "text": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ"}, {"verse_key": "105:3", "text": "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ"}, {"verse_key": "105:4", "text": "تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ"}, {"verse_key": "105:5", "text": "فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ"}]