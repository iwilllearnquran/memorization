[{"verse_key": "109:1", "text": " قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ"}, {"verse_key": "109:2", "text": "لَآ أَعْبُدُ مَا تَعْبُدُونَ"}, {"verse_key": "109:3", "text": "وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"}, {"verse_key": "109:4", "text": "وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ"}, {"verse_key": "109:5", "text": "وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"}, {"verse_key": "109:6", "text": "لَكُمْ دِينُكُمْ وَلِىَ دِينِ"}]