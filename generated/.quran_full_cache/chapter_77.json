[{"verse_key": "77:1", "text": " وَٱلْمُرْسَلَـٰتِ عُرْفًا"}, {"verse_key": "77:2", "text": "فَٱلْعَـٰصِفَـٰتِ عَصْفًا"}, {"verse_key": "77:3", "text": "وَٱلنَّـٰشِرَٰتِ نَشْرًا"}, {"verse_key": "77:4", "text": "فَٱلْفَـٰرِقَـٰتِ فَرْقًا"}, {"verse_key": "77:5", "text": "فَٱلْمُلْقِيَـٰتِ ذِكْرًا"}, {"verse_key": "77:6", "text": "عُذْرًا أَوْ نُذْرًا"}, {"verse_key": "77:7", "text": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ"}, {"verse_key": "77:8", "text": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ"}, {"verse_key": "77:9", "text": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ"}, {"verse_key": "77:10", "text": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ"}, {"verse_key": "77:11", "text": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ"}, {"verse_key": "77:12", "text": "لِأَىِّ يَوْمٍ أُجِّلَتْ"}, {"verse_key": "77:13", "text": "لِيَوْمِ ٱلْفَصْلِ"}, {"verse_key": "77:14", "text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ"}, {"verse_key": "77:15", "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"verse_key": "77:16", "text": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ"}, {"verse_key": "77:17", "text": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ"}, {"verse_key": "77:18", "text": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"}, {"verse_key": "77:19", "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"verse_key": "77:20", "text": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ"}, {"verse_key": "77:21", "text": "فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ"}, {"verse_key": "77:22", "text": "إِلَىٰ قَدَرٍ مَّعْلُومٍ"}, {"verse_key": "77:23", "text": "فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ"}, {"verse_key": "77:24", "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"verse_key": "77:25", "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا"}, {"verse_key": "77:26", "text": "أَحْيَآءً وَأَمْوَٰتًا"}, {"verse_key": "77:27", "text": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا"}, {"verse_key": "77:28", "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"verse_key": "77:29", "text": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"}, {"verse_key": "77:30", "text": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ"}, {"verse_key": "77:31", "text": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ"}, {"verse_key": "77:32", "text": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ"}, {"verse_key": "77:33", "text": "كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ"}, {"verse_key": "77:34", "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"verse_key": "77:35", "text": "هَـٰذَا يَوْمُ لَا يَنطِقُونَ"}, {"verse_key": "77:36", "text": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ"}, {"verse_key": "77:37", "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"verse_key": "77:38", "text": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ"}, {"verse_key": "77:39", "text": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ"}, {"verse_key": "77:40", "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"verse_key": "77:41", "text": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ"}, {"verse_key": "77:42", "text": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ"}, {"verse_key": "77:43", "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ"}, {"verse_key": "77:44", "text": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"}, {"verse_key": "77:45", "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"verse_key": "77:46", "text": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ"}, {"verse_key": "77:47", "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"verse_key": "77:48", "text": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ"}, {"verse_key": "77:49", "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"verse_key": "77:50", "text": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ"}]