[{"verse_key": "84:1", "text": " إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ"}, {"verse_key": "84:2", "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"}, {"verse_key": "84:3", "text": "وَإِذَا ٱلْأَرْضُ مُدَّتْ"}, {"verse_key": "84:4", "text": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"}, {"verse_key": "84:5", "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"}, {"verse_key": "84:6", "text": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَـٰقِيهِ"}, {"verse_key": "84:7", "text": "فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ"}, {"verse_key": "84:8", "text": "فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا"}, {"verse_key": "84:9", "text": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا"}, {"verse_key": "84:10", "text": "وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ"}, {"verse_key": "84:11", "text": "فَسَوْفَ يَدْعُوا۟ ثُبُورًا"}, {"verse_key": "84:12", "text": "وَيَصْلَىٰ سَعِيرًا"}, {"verse_key": "84:13", "text": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا"}, {"verse_key": "84:14", "text": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"}, {"verse_key": "84:15", "text": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا"}, {"verse_key": "84:16", "text": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ"}, {"verse_key": "84:17", "text": "وَٱلَّيْلِ وَمَا وَسَقَ"}, {"verse_key": "84:18", "text": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ"}, {"verse_key": "84:19", "text": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ"}, {"verse_key": "84:20", "text": "فَمَا لَهُمْ لَا يُؤْمِنُونَ"}, {"verse_key": "84:21", "text": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩"}, {"verse_key": "84:22", "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ"}, {"verse_key": "84:23", "text": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ"}, {"verse_key": "84:24", "text": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ"}, {"verse_key": "84:25", "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ"}]