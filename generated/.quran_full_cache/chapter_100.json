[{"verse_key": "100:1", "text": " وَٱلْعَـٰدِيَـٰتِ ضَبْحًا"}, {"verse_key": "100:2", "text": "فَٱلْمُورِيَـٰتِ قَدْحًا"}, {"verse_key": "100:3", "text": "فَٱلْمُغِيرَٰتِ صُبْحًا"}, {"verse_key": "100:4", "text": "فَأَثَرْنَ بِهِۦ نَقْعًا"}, {"verse_key": "100:5", "text": "فَوَسَطْنَ بِهِۦ جَمْعًا"}, {"verse_key": "100:6", "text": "إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ"}, {"verse_key": "100:7", "text": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ"}, {"verse_key": "100:8", "text": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ"}, {"verse_key": "100:9", "text": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ"}, {"verse_key": "100:10", "text": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ"}, {"verse_key": "100:11", "text": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ"}]