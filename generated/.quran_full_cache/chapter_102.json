[{"verse_key": "102:1", "text": " أَلْهَىٰكُمُ ٱلتَّكَاثُرُ"}, {"verse_key": "102:2", "text": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ"}, {"verse_key": "102:3", "text": "كَلَّا سَوْفَ تَعْلَمُونَ"}, {"verse_key": "102:4", "text": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ"}, {"verse_key": "102:5", "text": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ"}, {"verse_key": "102:6", "text": "لَتَرَوُنَّ ٱلْجَحِيمَ"}, {"verse_key": "102:7", "text": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ"}, {"verse_key": "102:8", "text": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ"}]