[{"verse_key": "114:1", "text": " قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ"}, {"verse_key": "114:2", "text": "مَلِكِ ٱلنَّاسِ"}, {"verse_key": "114:3", "text": "إِلَـٰهِ ٱلنَّاسِ"}, {"verse_key": "114:4", "text": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ"}, {"verse_key": "114:5", "text": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ"}, {"verse_key": "114:6", "text": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ"}]