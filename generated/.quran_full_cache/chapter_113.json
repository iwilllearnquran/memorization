[{"verse_key": "113:1", "text": " قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ"}, {"verse_key": "113:2", "text": "مِن شَرِّ مَا خَلَقَ"}, {"verse_key": "113:3", "text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"}, {"verse_key": "113:4", "text": "وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ"}, {"verse_key": "113:5", "text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"}]