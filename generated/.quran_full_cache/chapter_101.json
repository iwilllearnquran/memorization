[{"verse_key": "101:1", "text": " ٱلْقَارِعَةُ"}, {"verse_key": "101:2", "text": "مَا ٱلْقَارِعَةُ"}, {"verse_key": "101:3", "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ"}, {"verse_key": "101:4", "text": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ"}, {"verse_key": "101:5", "text": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ"}, {"verse_key": "101:6", "text": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ"}, {"verse_key": "101:7", "text": "فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ"}, {"verse_key": "101:8", "text": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ"}, {"verse_key": "101:9", "text": "فَأُمُّهُۥ هَاوِيَةٌ"}, {"verse_key": "101:10", "text": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ"}, {"verse_key": "101:11", "text": "نَارٌ حَامِيَةٌۢ"}]