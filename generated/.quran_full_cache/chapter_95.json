[{"verse_key": "95:1", "text": "وَٱلتِّينِ وَٱلزَّيْتُونِ"}, {"verse_key": "95:2", "text": "وَطُورِ سِينِينَ"}, {"verse_key": "95:3", "text": "وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ"}, {"verse_key": "95:4", "text": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ"}, {"verse_key": "95:5", "text": "ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ"}, {"verse_key": "95:6", "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ"}, {"verse_key": "95:7", "text": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ"}, {"verse_key": "95:8", "text": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ"}]