[{"verse_key": "81:1", "text": " إِذَا ٱلشَّمْسُ كُوِّرَتْ"}, {"verse_key": "81:2", "text": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ"}, {"verse_key": "81:3", "text": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ"}, {"verse_key": "81:4", "text": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ"}, {"verse_key": "81:5", "text": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ"}, {"verse_key": "81:6", "text": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ"}, {"verse_key": "81:7", "text": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ"}, {"verse_key": "81:8", "text": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ"}, {"verse_key": "81:9", "text": "بِأَىِّ ذَنۢبٍ قُتِلَتْ"}, {"verse_key": "81:10", "text": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ"}, {"verse_key": "81:11", "text": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ"}, {"verse_key": "81:12", "text": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ"}, {"verse_key": "81:13", "text": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ"}, {"verse_key": "81:14", "text": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ"}, {"verse_key": "81:15", "text": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ"}, {"verse_key": "81:16", "text": "ٱلْجَوَارِ ٱلْكُنَّسِ"}, {"verse_key": "81:17", "text": "وَٱلَّيْلِ إِذَا عَسْعَسَ"}, {"verse_key": "81:18", "text": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ"}, {"verse_key": "81:19", "text": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ"}, {"verse_key": "81:20", "text": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ"}, {"verse_key": "81:21", "text": "مُّطَاعٍ ثَمَّ أَمِينٍ"}, {"verse_key": "81:22", "text": "وَمَا صَاحِبُكُم بِمَجْنُونٍ"}, {"verse_key": "81:23", "text": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ"}, {"verse_key": "81:24", "text": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ"}, {"verse_key": "81:25", "text": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ"}, {"verse_key": "81:26", "text": "فَأَيْنَ تَذْهَبُونَ"}, {"verse_key": "81:27", "text": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ"}, {"verse_key": "81:28", "text": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ"}, {"verse_key": "81:29", "text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ"}]