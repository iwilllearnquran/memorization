[{"verse_key": "93:1", "text": " وَٱلضُّحَىٰ"}, {"verse_key": "93:2", "text": "وَٱلَّيْلِ إِذَا سَجَىٰ"}, {"verse_key": "93:3", "text": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"}, {"verse_key": "93:4", "text": "وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ"}, {"verse_key": "93:5", "text": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ"}, {"verse_key": "93:6", "text": "أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ"}, {"verse_key": "93:7", "text": "وَوَجَدَكَ ضَآلًّا فَهَدَىٰ"}, {"verse_key": "93:8", "text": "وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ"}, {"verse_key": "93:9", "text": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ"}, {"verse_key": "93:10", "text": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ"}, {"verse_key": "93:11", "text": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"}]