[{"verse_key": "37:1", "text": " وَٱلصَّـٰٓفَّـٰتِ صَفًّا"}, {"verse_key": "37:2", "text": "فَٱلزَّٰجِرَٰتِ زَجْرًا"}, {"verse_key": "37:3", "text": "فَٱلتَّـٰلِيَـٰتِ ذِكْرًا"}, {"verse_key": "37:4", "text": "إِنَّ إِلَـٰهَكُمْ لَوَٰحِدٌ"}, {"verse_key": "37:5", "text": "رَّبُّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَـٰرِقِ"}, {"verse_key": "37:6", "text": "إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ"}, {"verse_key": "37:7", "text": "وَحِفْظًا مِّن كُلِّ شَيْطَـٰنٍ مَّارِدٍ"}, {"verse_key": "37:8", "text": "لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ"}, {"verse_key": "37:9", "text": "دُحُورًا ۖ وَلَهُمْ عَذَابٌ وَاصِبٌ"}, {"verse_key": "37:10", "text": "إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌ ثَاقِبٌ"}, {"verse_key": "37:11", "text": "فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَـٰهُم مِّن طِينٍ لَّازِبٍۭ"}, {"verse_key": "37:12", "text": "بَلْ عَجِبْتَ وَيَسْخَرُونَ"}, {"verse_key": "37:13", "text": "وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ"}, {"verse_key": "37:14", "text": "وَإِذَا رَأَوْا۟ ءَايَةً يَسْتَسْخِرُونَ"}, {"verse_key": "37:15", "text": "وَقَالُوٓا۟ إِنْ هَـٰذَآ إِلَّا سِحْرٌ مُّبِينٌ"}, {"verse_key": "37:16", "text": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ"}, {"verse_key": "37:17", "text": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ"}, {"verse_key": "37:18", "text": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ"}, {"verse_key": "37:19", "text": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ"}, {"verse_key": "37:20", "text": "وَقَالُوا۟ يَـٰوَيْلَنَا هَـٰذَا يَوْمُ ٱلدِّينِ"}, {"verse_key": "37:21", "text": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ"}, {"verse_key": "37:22", "text": "۞ ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ"}, {"verse_key": "37:23", "text": "مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ"}, {"verse_key": "37:24", "text": "وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ"}, {"verse_key": "37:25", "text": "مَا لَكُمْ لَا تَنَاصَرُونَ"}, {"verse_key": "37:26", "text": "بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ"}, {"verse_key": "37:27", "text": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"}, {"verse_key": "37:28", "text": "قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ"}, {"verse_key": "37:29", "text": "قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ"}, {"verse_key": "37:30", "text": "وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَـٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًا طَـٰغِينَ"}, {"verse_key": "37:31", "text": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ"}, {"verse_key": "37:32", "text": "فَأَغْوَيْنَـٰكُمْ إِنَّا كُنَّا غَـٰوِينَ"}, {"verse_key": "37:33", "text": "فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ"}, {"verse_key": "37:34", "text": "إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"}, {"verse_key": "37:35", "text": "إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَـٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ"}, {"verse_key": "37:36", "text": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ"}, {"verse_key": "37:37", "text": "بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ"}, {"verse_key": "37:38", "text": "إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ"}, {"verse_key": "37:39", "text": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ"}, {"verse_key": "37:40", "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"}, {"verse_key": "37:41", "text": "أُو۟لَـٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ"}, {"verse_key": "37:42", "text": "فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ"}, {"verse_key": "37:43", "text": "فِى جَنَّـٰتِ ٱلنَّعِيمِ"}, {"verse_key": "37:44", "text": "عَلَىٰ سُرُرٍ مُّتَقَـٰبِلِينَ"}, {"verse_key": "37:45", "text": "يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ"}, {"verse_key": "37:46", "text": "بَيْضَآءَ لَذَّةٍ لِّلشَّـٰرِبِينَ"}, {"verse_key": "37:47", "text": "لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ"}, {"verse_key": "37:48", "text": "وَعِندَهُمْ قَـٰصِرَٰتُ ٱلطَّرْفِ عِينٌ"}, {"verse_key": "37:49", "text": "كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ"}, {"verse_key": "37:50", "text": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"}, {"verse_key": "37:51", "text": "قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ"}, {"verse_key": "37:52", "text": "يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ"}, {"verse_key": "37:53", "text": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَدِينُونَ"}, {"verse_key": "37:54", "text": "قَالَ هَلْ أَنتُم مُّطَّلِعُونَ"}, {"verse_key": "37:55", "text": "فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ"}, {"verse_key": "37:56", "text": "قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ"}, {"verse_key": "37:57", "text": "وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ"}, {"verse_key": "37:58", "text": "أَفَمَا نَحْنُ بِمَيِّتِينَ"}, {"verse_key": "37:59", "text": "إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ"}, {"verse_key": "37:60", "text": "إِنَّ هَـٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ"}, {"verse_key": "37:61", "text": "لِمِثْلِ هَـٰذَا فَلْيَعْمَلِ ٱلْعَـٰمِلُونَ"}, {"verse_key": "37:62", "text": "أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ"}, {"verse_key": "37:63", "text": "إِنَّا جَعَلْنَـٰهَا فِتْنَةً لِّلظَّـٰلِمِينَ"}, {"verse_key": "37:64", "text": "إِنَّهَا شَجَرَةٌ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ"}, {"verse_key": "37:65", "text": "طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَـٰطِينِ"}, {"verse_key": "37:66", "text": "فَإِنَّهُمْ لَـَٔاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ"}, {"verse_key": "37:67", "text": "ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ"}, {"verse_key": "37:68", "text": "ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ"}, {"verse_key": "37:69", "text": "إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ ضَآلِّينَ"}, {"verse_key": "37:70", "text": "فَهُمْ عَلَىٰٓ ءَاثَـٰرِهِمْ يُهْرَعُونَ"}, {"verse_key": "37:71", "text": "وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ"}, {"verse_key": "37:72", "text": "وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ"}, {"verse_key": "37:73", "text": "فَٱنظُرْ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُنذَرِينَ"}, {"verse_key": "37:74", "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"}, {"verse_key": "37:75", "text": "وَلَقَدْ نَادَىٰنَا نُوحٌ فَلَنِعْمَ ٱلْمُجِيبُونَ"}, {"verse_key": "37:76", "text": "وَنَجَّيْنَـٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ"}, {"verse_key": "37:77", "text": "وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ ٱلْبَاقِينَ"}, {"verse_key": "37:78", "text": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"}, {"verse_key": "37:79", "text": "سَلَـٰمٌ عَلَىٰ نُوحٍ فِى ٱلْعَـٰلَمِينَ"}, {"verse_key": "37:80", "text": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"}, {"verse_key": "37:81", "text": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"}, {"verse_key": "37:82", "text": "ثُمَّ أَغْرَقْنَا ٱلْـَٔاخَرِينَ"}, {"verse_key": "37:83", "text": "۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ"}, {"verse_key": "37:84", "text": "إِذْ جَآءَ رَبَّهُۥ بِقَلْبٍ سَلِيمٍ"}, {"verse_key": "37:85", "text": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَ"}, {"verse_key": "37:86", "text": "أَئِفْكًا ءَالِهَةً دُونَ ٱللَّهِ تُرِيدُونَ"}, {"verse_key": "37:87", "text": "فَمَا ظَنُّكُم بِرَبِّ ٱلْعَـٰلَمِينَ"}, {"verse_key": "37:88", "text": "فَنَظَرَ نَظْرَةً فِى ٱلنُّجُومِ"}, {"verse_key": "37:89", "text": "فَقَالَ إِنِّى سَقِيمٌ"}, {"verse_key": "37:90", "text": "فَتَوَلَّوْا۟ عَنْهُ مُدْبِرِينَ"}, {"verse_key": "37:91", "text": "فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ"}, {"verse_key": "37:92", "text": "مَا لَكُمْ لَا تَنطِقُونَ"}, {"verse_key": "37:93", "text": "فَرَاغَ عَلَيْهِمْ ضَرْبًۢا بِٱلْيَمِينِ"}, {"verse_key": "37:94", "text": "فَأَقْبَلُوٓا۟ إِلَيْهِ يَزِفُّونَ"}, {"verse_key": "37:95", "text": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ"}, {"verse_key": "37:96", "text": "وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ"}, {"verse_key": "37:97", "text": "قَالُوا۟ ٱبْنُوا۟ لَهُۥ بُنْيَـٰنًا فَأَلْقُوهُ فِى ٱلْجَحِيمِ"}, {"verse_key": "37:98", "text": "فَأَرَادُوا۟ بِهِۦ كَيْدًا فَجَعَلْنَـٰهُمُ ٱلْأَسْفَلِينَ"}, {"verse_key": "37:99", "text": "وَقَالَ إِنِّى ذَاهِبٌ إِلَىٰ رَبِّى سَيَهْدِينِ"}, {"verse_key": "37:100", "text": "رَبِّ هَبْ لِى مِنَ ٱلصَّـٰلِحِينَ"}, {"verse_key": "37:101", "text": "فَبَشَّرْنَـٰهُ بِغُلَـٰمٍ حَلِيمٍ"}, {"verse_key": "37:102", "text": "فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعْىَ قَالَ يَـٰبُنَىَّ إِنِّىٓ أَرَىٰ فِى ٱلْمَنَامِ أَنِّىٓ أَذْبَحُكَ فَٱنظُرْ مَاذَا تَرَىٰ ۚ قَالَ يَـٰٓأَبَتِ ٱفْعَلْ مَا تُؤْمَرُ ۖ سَتَجِدُنِىٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّـٰبِرِينَ"}, {"verse_key": "37:103", "text": "فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ"}, {"verse_key": "37:104", "text": "وَنَـٰدَيْنَـٰهُ أَن يَـٰٓإِبْرَٰهِيمُ"}, {"verse_key": "37:105", "text": "قَدْ صَدَّقْتَ ٱلرُّءْيَآ ۚ إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"}, {"verse_key": "37:106", "text": "إِنَّ هَـٰذَا لَهُوَ ٱلْبَلَـٰٓؤُا۟ ٱلْمُبِينُ"}, {"verse_key": "37:107", "text": "وَفَدَيْنَـٰهُ بِذِبْحٍ عَظِيمٍ"}, {"verse_key": "37:108", "text": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"}, {"verse_key": "37:109", "text": "سَلَـٰمٌ عَلَىٰٓ إِبْرَٰهِيمَ"}, {"verse_key": "37:110", "text": "كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"}, {"verse_key": "37:111", "text": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"}, {"verse_key": "37:112", "text": "وَبَشَّرْنَـٰهُ بِإِسْحَـٰقَ نَبِيًّا مِّنَ ٱلصَّـٰلِحِينَ"}, {"verse_key": "37:113", "text": "وَبَـٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَـٰقَ ۚ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌ وَظَالِمٌ لِّنَفْسِهِۦ مُبِينٌ"}, {"verse_key": "37:114", "text": "وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَـٰرُونَ"}, {"verse_key": "37:115", "text": "وَنَجَّيْنَـٰهُمَا وَقَوْمَهُمَا مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ"}, {"verse_key": "37:116", "text": "وَنَصَرْنَـٰهُمْ فَكَانُوا۟ هُمُ ٱلْغَـٰلِبِينَ"}, {"verse_key": "37:117", "text": "وَءَاتَيْنَـٰهُمَا ٱلْكِتَـٰبَ ٱلْمُسْتَبِينَ"}, {"verse_key": "37:118", "text": "وَهَدَيْنَـٰهُمَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ"}, {"verse_key": "37:119", "text": "وَتَرَكْنَا عَلَيْهِمَا فِى ٱلْـَٔاخِرِينَ"}, {"verse_key": "37:120", "text": "سَلَـٰمٌ عَلَىٰ مُوسَىٰ وَهَـٰرُونَ"}, {"verse_key": "37:121", "text": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"}, {"verse_key": "37:122", "text": "إِنَّهُمَا مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"}, {"verse_key": "37:123", "text": "وَإِنَّ إِلْيَاسَ لَمِنَ ٱلْمُرْسَلِينَ"}, {"verse_key": "37:124", "text": "إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ"}, {"verse_key": "37:125", "text": "أَتَدْعُونَ بَعْلًا وَتَذَرُونَ أَحْسَنَ ٱلْخَـٰلِقِينَ"}, {"verse_key": "37:126", "text": "ٱللَّهَ رَبَّكُمْ وَرَبَّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ"}, {"verse_key": "37:127", "text": "فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ"}, {"verse_key": "37:128", "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"}, {"verse_key": "37:129", "text": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"}, {"verse_key": "37:130", "text": "سَلَـٰمٌ عَلَىٰٓ إِلْ يَاسِينَ"}, {"verse_key": "37:131", "text": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"}, {"verse_key": "37:132", "text": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"}, {"verse_key": "37:133", "text": "وَإِنَّ لُوطًا لَّمِنَ ٱلْمُرْسَلِينَ"}, {"verse_key": "37:134", "text": "إِذْ نَجَّيْنَـٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ"}, {"verse_key": "37:135", "text": "إِلَّا عَجُوزًا فِى ٱلْغَـٰبِرِينَ"}, {"verse_key": "37:136", "text": "ثُمَّ دَمَّرْنَا ٱلْـَٔاخَرِينَ"}, {"verse_key": "37:137", "text": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ"}, {"verse_key": "37:138", "text": "وَبِٱلَّيْلِ ۗ أَفَلَا تَعْقِلُونَ"}, {"verse_key": "37:139", "text": "وَإِنَّ يُونُسَ لَمِنَ ٱلْمُرْسَلِينَ"}, {"verse_key": "37:140", "text": "إِذْ أَبَقَ إِلَى ٱلْفُلْكِ ٱلْمَشْحُونِ"}, {"verse_key": "37:141", "text": "فَسَاهَمَ فَكَانَ مِنَ ٱلْمُدْحَضِينَ"}, {"verse_key": "37:142", "text": "فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ مُلِيمٌ"}, {"verse_key": "37:143", "text": "فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ ٱلْمُسَبِّحِينَ"}, {"verse_key": "37:144", "text": "لَلَبِثَ فِى بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَ"}, {"verse_key": "37:145", "text": "۞ فَنَبَذْنَـٰهُ بِٱلْعَرَآءِ وَهُوَ سَقِيمٌ"}, {"verse_key": "37:146", "text": "وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةً مِّن يَقْطِينٍ"}, {"verse_key": "37:147", "text": "وَأَرْسَلْنَـٰهُ إِلَىٰ مِا۟ئَةِ أَلْفٍ أَوْ يَزِيدُونَ"}, {"verse_key": "37:148", "text": "فَـَٔامَنُوا۟ فَمَتَّعْنَـٰهُمْ إِلَىٰ حِينٍ"}, {"verse_key": "37:149", "text": "فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ"}, {"verse_key": "37:150", "text": "أَمْ خَلَقْنَا ٱلْمَلَـٰٓئِكَةَ إِنَـٰثًا وَهُمْ شَـٰهِدُونَ"}, {"verse_key": "37:151", "text": "أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ"}, {"verse_key": "37:152", "text": "وَلَدَ ٱللَّهُ وَإِنَّهُمْ لَكَـٰذِبُونَ"}, {"verse_key": "37:153", "text": "أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ"}, {"verse_key": "37:154", "text": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ"}, {"verse_key": "37:155", "text": "أَفَلَا تَذَكَّرُونَ"}, {"verse_key": "37:156", "text": "أَمْ لَكُمْ سُلْطَـٰنٌ مُّبِينٌ"}, {"verse_key": "37:157", "text": "فَأْتُوا۟ بِكِتَـٰبِكُمْ إِن كُنتُمْ صَـٰدِقِينَ"}, {"verse_key": "37:158", "text": "وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًا ۚ وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ"}, {"verse_key": "37:159", "text": "سُبْحَـٰنَ ٱللَّهِ عَمَّا يَصِفُونَ"}, {"verse_key": "37:160", "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"}, {"verse_key": "37:161", "text": "فَإِنَّكُمْ وَمَا تَعْبُدُونَ"}, {"verse_key": "37:162", "text": "مَآ أَنتُمْ عَلَيْهِ بِفَـٰتِنِينَ"}, {"verse_key": "37:163", "text": "إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ"}, {"verse_key": "37:164", "text": "وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌ مَّعْلُومٌ"}, {"verse_key": "37:165", "text": "وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ"}, {"verse_key": "37:166", "text": "وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ"}, {"verse_key": "37:167", "text": "وَإِن كَانُوا۟ لَيَقُولُونَ"}, {"verse_key": "37:168", "text": "لَوْ أَنَّ عِندَنَا ذِكْرًا مِّنَ ٱلْأَوَّلِينَ"}, {"verse_key": "37:169", "text": "لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"}, {"verse_key": "37:170", "text": "فَكَفَرُوا۟ بِهِۦ ۖ فَسَوْفَ يَعْلَمُونَ"}, {"verse_key": "37:171", "text": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ"}, {"verse_key": "37:172", "text": "إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ"}, {"verse_key": "37:173", "text": "وَإِنَّ جُندَنَا لَهُمُ ٱلْغَـٰلِبُونَ"}, {"verse_key": "37:174", "text": "فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"}, {"verse_key": "37:175", "text": "وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ"}, {"verse_key": "37:176", "text": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"}, {"verse_key": "37:177", "text": "فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ"}, {"verse_key": "37:178", "text": "وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"}, {"verse_key": "37:179", "text": "وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ"}, {"verse_key": "37:180", "text": "سُبْحَـٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ"}, {"verse_key": "37:181", "text": "وَسَلَـٰمٌ عَلَى ٱلْمُرْسَلِينَ"}, {"verse_key": "37:182", "text": "وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ"}]