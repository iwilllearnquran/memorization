[{"verse_key": "88:1", "text": " هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ"}, {"verse_key": "88:2", "text": "وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ"}, {"verse_key": "88:3", "text": "عَامِلَةٌ نَّاصِبَةٌ"}, {"verse_key": "88:4", "text": "تَصْلَىٰ نَارًا حَامِيَةً"}, {"verse_key": "88:5", "text": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ"}, {"verse_key": "88:6", "text": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ"}, {"verse_key": "88:7", "text": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ"}, {"verse_key": "88:8", "text": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ"}, {"verse_key": "88:9", "text": "لِّسَعْيِهَا رَاضِيَةٌ"}, {"verse_key": "88:10", "text": "فِى جَنَّةٍ عَالِيَةٍ"}, {"verse_key": "88:11", "text": "لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً"}, {"verse_key": "88:12", "text": "فِيهَا عَيْنٌ جَارِيَةٌ"}, {"verse_key": "88:13", "text": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ"}, {"verse_key": "88:14", "text": "وَأَكْوَابٌ مَّوْضُوعَةٌ"}, {"verse_key": "88:15", "text": "وَنَمَارِقُ مَصْفُوفَةٌ"}, {"verse_key": "88:16", "text": "وَزَرَابِىُّ مَبْثُوثَةٌ"}, {"verse_key": "88:17", "text": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ"}, {"verse_key": "88:18", "text": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ"}, {"verse_key": "88:19", "text": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ"}, {"verse_key": "88:20", "text": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ"}, {"verse_key": "88:21", "text": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ"}, {"verse_key": "88:22", "text": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ"}, {"verse_key": "88:23", "text": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ"}, {"verse_key": "88:24", "text": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ"}, {"verse_key": "88:25", "text": "إِنَّ إِلَيْنَآ إِيَابَهُمْ"}, {"verse_key": "88:26", "text": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم"}]