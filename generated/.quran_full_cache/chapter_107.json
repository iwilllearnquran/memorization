[{"verse_key": "107:1", "text": " أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ"}, {"verse_key": "107:2", "text": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ"}, {"verse_key": "107:3", "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"}, {"verse_key": "107:4", "text": "فَوَيْلٌ لِّلْمُصَلِّينَ"}, {"verse_key": "107:5", "text": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"}, {"verse_key": "107:6", "text": "ٱلَّذِينَ هُمْ يُرَآءُونَ"}, {"verse_key": "107:7", "text": "وَيَمْنَعُونَ ٱلْمَاعُونَ"}]