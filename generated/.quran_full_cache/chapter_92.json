[{"verse_key": "92:1", "text": " وَٱلَّيْلِ إِذَا يَغْشَىٰ"}, {"verse_key": "92:2", "text": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"}, {"verse_key": "92:3", "text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"}, {"verse_key": "92:4", "text": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ"}, {"verse_key": "92:5", "text": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ"}, {"verse_key": "92:6", "text": "وَصَدَّقَ بِٱلْحُسْنَىٰ"}, {"verse_key": "92:7", "text": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ"}, {"verse_key": "92:8", "text": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ"}, {"verse_key": "92:9", "text": "وَكَذَّبَ بِٱلْحُسْنَىٰ"}, {"verse_key": "92:10", "text": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ"}, {"verse_key": "92:11", "text": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"}, {"verse_key": "92:12", "text": "إِنَّ عَلَيْنَا لَلْهُدَىٰ"}, {"verse_key": "92:13", "text": "وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ"}, {"verse_key": "92:14", "text": "فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ"}, {"verse_key": "92:15", "text": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى"}, {"verse_key": "92:16", "text": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ"}, {"verse_key": "92:17", "text": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى"}, {"verse_key": "92:18", "text": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ"}, {"verse_key": "92:19", "text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ"}, {"verse_key": "92:20", "text": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ"}, {"verse_key": "92:21", "text": "وَلَسَوْفَ يَرْضَىٰ"}]