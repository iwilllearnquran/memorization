[{"verse_key": "87:1", "text": " سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى"}, {"verse_key": "87:2", "text": "ٱلَّذِى خَلَقَ فَسَوَّىٰ"}, {"verse_key": "87:3", "text": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ"}, {"verse_key": "87:4", "text": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ"}, {"verse_key": "87:5", "text": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ"}, {"verse_key": "87:6", "text": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ"}, {"verse_key": "87:7", "text": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ"}, {"verse_key": "87:8", "text": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ"}, {"verse_key": "87:9", "text": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ"}, {"verse_key": "87:10", "text": "سَيَذَّكَّرُ مَن يَخْشَىٰ"}, {"verse_key": "87:11", "text": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى"}, {"verse_key": "87:12", "text": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ"}, {"verse_key": "87:13", "text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"}, {"verse_key": "87:14", "text": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ"}, {"verse_key": "87:15", "text": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ"}, {"verse_key": "87:16", "text": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"}, {"verse_key": "87:17", "text": "وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ"}, {"verse_key": "87:18", "text": "إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ"}, {"verse_key": "87:19", "text": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ"}]