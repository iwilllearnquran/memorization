[{"verse_key": "70:1", "text": " سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ"}, {"verse_key": "70:2", "text": "لِّلْكَـٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ"}, {"verse_key": "70:3", "text": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ"}, {"verse_key": "70:4", "text": "تَعْرُجُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ"}, {"verse_key": "70:5", "text": "فَٱصْبِرْ صَبْرًا جَمِيلًا"}, {"verse_key": "70:6", "text": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا"}, {"verse_key": "70:7", "text": "وَنَرَىٰهُ قَرِيبًا"}, {"verse_key": "70:8", "text": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ"}, {"verse_key": "70:9", "text": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ"}, {"verse_key": "70:10", "text": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا"}, {"verse_key": "70:11", "text": "يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ"}, {"verse_key": "70:12", "text": "وَصَـٰحِبَتِهِۦ وَأَخِيهِ"}, {"verse_key": "70:13", "text": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ"}, {"verse_key": "70:14", "text": "وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ"}, {"verse_key": "70:15", "text": "كَلَّآ ۖ إِنَّهَا لَظَىٰ"}, {"verse_key": "70:16", "text": "نَزَّاعَةً لِّلشَّوَىٰ"}, {"verse_key": "70:17", "text": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ"}, {"verse_key": "70:18", "text": "وَجَمَعَ فَأَوْعَىٰٓ"}, {"verse_key": "70:19", "text": "۞ إِنَّ ٱلْإِنسَـٰنَ خُلِقَ هَلُوعًا"}, {"verse_key": "70:20", "text": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا"}, {"verse_key": "70:21", "text": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا"}, {"verse_key": "70:22", "text": "إِلَّا ٱلْمُصَلِّينَ"}, {"verse_key": "70:23", "text": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ"}, {"verse_key": "70:24", "text": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ"}, {"verse_key": "70:25", "text": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ"}, {"verse_key": "70:26", "text": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ"}, {"verse_key": "70:27", "text": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ"}, {"verse_key": "70:28", "text": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ"}, {"verse_key": "70:29", "text": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَـٰفِظُونَ"}, {"verse_key": "70:30", "text": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ"}, {"verse_key": "70:31", "text": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ"}, {"verse_key": "70:32", "text": "وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ"}, {"verse_key": "70:33", "text": "وَٱلَّذِينَ هُم بِشَهَـٰدَٰتِهِمْ قَآئِمُونَ"}, {"verse_key": "70:34", "text": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ"}, {"verse_key": "70:35", "text": "أُو۟لَـٰٓئِكَ فِى جَنَّـٰتٍ مُّكْرَمُونَ"}, {"verse_key": "70:36", "text": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ"}, {"verse_key": "70:37", "text": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ"}, {"verse_key": "70:38", "text": "أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ"}, {"verse_key": "70:39", "text": "كَلَّآ ۖ إِنَّا خَلَقْنَـٰهُم مِّمَّا يَعْلَمُونَ"}, {"verse_key": "70:40", "text": "فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَـٰرِقِ وَٱلْمَغَـٰرِبِ إِنَّا لَقَـٰدِرُونَ"}, {"verse_key": "70:41", "text": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ"}, {"verse_key": "70:42", "text": "فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ"}, {"verse_key": "70:43", "text": "يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًا كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ"}, {"verse_key": "70:44", "text": "خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ"}]