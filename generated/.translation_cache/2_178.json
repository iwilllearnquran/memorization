{"words": [{"text": "يَـٰٓأَيُّهَا", "translation": "O you"}, {"text": "ٱلَّذِينَ", "translation": "who"}, {"text": "ءَامَنُوا۟", "translation": "believe[d]"}, {"text": "كُتِبَ", "translation": "Prescribed"}, {"text": "عَلَيْكُمُ", "translation": "for you"}, {"text": "ٱلْقِصَاصُ", "translation": "(is) the legal retribution"}, {"text": "فِى", "translation": "in"}, {"text": "ٱلْقَتْلَى ۖ", "translation": "(the matter of) the murdered"}, {"text": "ٱلْحُرُّ", "translation": "the freeman"}, {"text": "بِٱلْحُرِّ", "translation": "for the freeman"}, {"text": "وَٱلْعَبْدُ", "translation": "and the slave"}, {"text": "بِٱلْعَبْدِ", "translation": "for the slave"}, {"text": "وَٱلْأُنثَىٰ", "translation": "and the female"}, {"text": "بِٱلْأُنثَىٰ ۚ", "translation": "for the female"}, {"text": "فَمَنْ", "translation": "But whoever"}, {"text": "عُفِىَ", "translation": "is pardoned"}, {"text": "لَهُۥ", "translation": "[for it]"}, {"text": "مِنْ", "translation": "from"}, {"text": "أَخِيهِ", "translation": "his brother"}, {"text": "شَىْءٌۭ", "translation": "anything"}, {"text": "فَٱتِّبَاعٌۢ", "translation": "then follows up"}, {"text": "بِٱلْمَعْرُوفِ", "translation": "with suitable"}, {"text": "وَأَدَآءٌ", "translation": "[and] payment"}, {"text": "إِلَيْهِ", "translation": "to him"}, {"text": "بِإِحْسَـٰنٍۢ ۗ", "translation": "with kindness"}, {"text": "ذَٰلِكَ", "translation": "That (is)"}, {"text": "تَخْفِيفٌۭ", "translation": "a concession"}, {"text": "مِّن", "translation": "from"}, {"text": "رَّبِّكُمْ", "translation": "your Lord"}, {"text": "وَرَحْمَةٌۭ ۗ", "translation": "and mercy"}, {"text": "فَمَنِ", "translation": "Then whoever"}, {"text": "ٱعْتَدَىٰ", "translation": "transgresses"}, {"text": "بَعْدَ", "translation": "after"}, {"text": "ذَٰلِكَ", "translation": "that"}, {"text": "فَلَهُۥ", "translation": "then for him"}, {"text": "عَذَابٌ", "translation": "(is) a punishment"}, {"text": "أَلِيمٌۭ", "translation": "painful"}], "sahih": "O you who have believed, prescribed for you is legal retribution for those murdered - the free for the free, the slave for the slave, and the female for the female.1 But whoever overlooks from his brother [i.e., the killer] anything,2 then there should be a suitable follow-up and payment to him [i.e., the deceased's heir or legal representative] with good conduct. This is an alleviation from your Lord and a mercy. But whoever transgresses after that3 will have a painful punishment."}