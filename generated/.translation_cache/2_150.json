{"words": [{"text": "وَمِنْ", "translation": "And from"}, {"text": "حَيْثُ", "translation": "wherever"}, {"text": "خَرَجْتَ", "translation": "you start forth"}, {"text": "فَوَلِّ", "translation": "[so] turn"}, {"text": "وَجْهَكَ", "translation": "your face"}, {"text": "شَطْرَ", "translation": "(in the) direction"}, {"text": "ٱلْمَسْجِدِ", "translation": "(of) Al-Masjid"}, {"text": "ٱلْحَرَامِ ۚ", "translation": "Al-Haraam"}, {"text": "وَحَيْثُ", "translation": "And wherever"}, {"text": "مَا", "translation": "that"}, {"text": "كُنتُمْ", "translation": "you (all) are"}, {"text": "فَوَلُّوا۟", "translation": "[so] turn"}, {"text": "وُجُوهَكُمْ", "translation": "your faces"}, {"text": "شَطْرَهُۥ", "translation": "(in) its direction"}, {"text": "لِئَلَّا", "translation": "so that not"}, {"text": "يَكُونَ", "translation": "will be"}, {"text": "لِلنَّاسِ", "translation": "for the people"}, {"text": "عَلَيْكُمْ", "translation": "against you"}, {"text": "حُجَّةٌ", "translation": "any argument"}, {"text": "إِلَّا", "translation": "except"}, {"text": "ٱلَّذِينَ", "translation": "those who"}, {"text": "ظَلَمُوا۟", "translation": "wronged"}, {"text": "مِنْهُمْ", "translation": "among them"}, {"text": "فَلَا", "translation": "so (do) not"}, {"text": "تَخْشَوْهُمْ", "translation": "fear them"}, {"text": "وَٱخْشَوْنِى", "translation": "but fear Me"}, {"text": "وَلِأُتِمَّ", "translation": "And that I complete"}, {"text": "نِعْمَتِى", "translation": "My favor"}, {"text": "عَلَيْكُمْ", "translation": "upon you"}, {"text": "وَلَعَلَّكُمْ", "translation": "[and] so that you may"}, {"text": "تَهْتَدُونَ", "translation": "(be) guided"}], "sahih": "And from wherever you go out [for prayer], turn your face toward al-Masjid al-Ḥarām. And wherever you [believers] may be, turn your faces toward it in order that the people will not have any argument against you, except for those of them who commit wrong; so fear them not but fear Me. And [it is] so I may complete My favor upon you and that you may be guided,"}