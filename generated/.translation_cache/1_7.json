{"words": [{"text": "صِرَٰطَ", "translation": "(The) path"}, {"text": "ٱلَّذِينَ", "translation": "(of) those"}, {"text": "أَنْعَمْتَ", "translation": "You have bestowed (Your) Favors"}, {"text": "عَلَيْهِمْ", "translation": "on them"}, {"text": "غَيْرِ", "translation": "not (of)"}, {"text": "ٱلْمَغْضُوبِ", "translation": "those who earned (Your) wrath"}, {"text": "عَلَيْهِمْ", "translation": "on themselves"}, {"text": "وَلَا", "translation": "and not"}, {"text": "ٱلضَّآلِّينَ", "translation": "(of) those who go astray"}], "sahih": "The path of those upon whom You have bestowed favor, not of those who have earned [Your] anger or of those who are astray."}