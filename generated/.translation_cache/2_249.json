{"words": [{"text": "فَلَمَّا", "translation": "Then when"}, {"text": "فَصَلَ", "translation": "set out"}, {"text": "طَالُوتُ", "translation": "Talut"}, {"text": "بِٱلْجُنُودِ", "translation": "with the forces"}, {"text": "قَالَ", "translation": "he said"}, {"text": "إِنَّ", "translation": "Indeed"}, {"text": "ٱللَّهَ", "translation": "Allah"}, {"text": "مُبْتَلِيكُم", "translation": "will test you"}, {"text": "بِنَهَرٍۢ", "translation": "with a river"}, {"text": "فَمَن", "translation": "So whoever"}, {"text": "شَرِبَ", "translation": "drinks"}, {"text": "مِنْهُ", "translation": "from it"}, {"text": "فَلَيْسَ", "translation": "then he is not"}, {"text": "مِنِّى", "translation": "from me"}, {"text": "وَمَن", "translation": "and whoever"}, {"text": "لَّمْ", "translation": "(does) not"}, {"text": "يَطْعَمْهُ", "translation": "taste it"}, {"text": "فَإِنَّهُۥ", "translation": "then indeed, he"}, {"text": "مِنِّىٓ", "translation": "(is) from me"}, {"text": "إِلَّا", "translation": "except"}, {"text": "مَنِ", "translation": "whoever"}, {"text": "ٱغْتَرَفَ", "translation": "takes"}, {"text": "غُرْفَةًۢ", "translation": "(in the) hollow"}, {"text": "بِيَدِهِۦ ۚ", "translation": "(of) his hand"}, {"text": "فَشَرِبُوا۟", "translation": "Then they drank"}, {"text": "مِنْهُ", "translation": "from it"}, {"text": "إِلَّا", "translation": "except"}, {"text": "قَلِيلًۭا", "translation": "a few"}, {"text": "مِّنْهُمْ ۚ", "translation": "of them"}, {"text": "فَلَمَّا", "translation": "Then when"}, {"text": "جَاوَزَهُۥ", "translation": "he crossed it"}, {"text": "هُوَ", "translation": "he"}, {"text": "وَٱلَّذِينَ", "translation": "and those who"}, {"text": "ءَامَنُوا۟", "translation": "believed"}, {"text": "مَعَهُۥ", "translation": "with him"}, {"text": "قَالُوا۟", "translation": "they said"}, {"text": "لَا", "translation": "No"}, {"text": "طَاقَةَ", "translation": "strength"}, {"text": "لَنَا", "translation": "for us"}, {"text": "ٱلْيَوْمَ", "translation": "today"}, {"text": "بِجَالُوتَ", "translation": "against Jalut"}, {"text": "وَجُنُودِهِۦ ۚ", "translation": "and his troops"}, {"text": "قَالَ", "translation": "Said"}, {"text": "ٱلَّذِينَ", "translation": "those who"}, {"text": "يَظُنُّونَ", "translation": "were certain"}, {"text": "أَنَّهُم", "translation": "that they"}, {"text": "مُّلَـٰقُوا۟", "translation": "(would) meet"}, {"text": "ٱللَّهِ", "translation": "Allah"}, {"text": "كَم", "translation": "How many"}, {"text": "مِّن", "translation": "of"}, {"text": "فِئَةٍۢ", "translation": "a company"}, {"text": "قَلِيلَةٍ", "translation": "small"}, {"text": "غَلَبَتْ", "translation": "overcame"}, {"text": "فِئَةًۭ", "translation": "a company"}, {"text": "كَثِيرَةًۢ", "translation": "large"}, {"text": "بِإِذْنِ", "translation": "by (the) permission"}, {"text": "ٱللَّهِ ۗ", "translation": "(of) Allah"}, {"text": "وَٱللَّهُ", "translation": "And Allah"}, {"text": "مَعَ", "translation": "(is) with"}, {"text": "ٱلصَّـٰبِرِينَ", "translation": "the patient ones"}], "sahih": "And when Saul went forth with the soldiers, he said, \"Indeed, Allāh will be testing you with a river. So whoever drinks from it is not of me, and whoever does not taste it is indeed of me, excepting one who takes [from it] in the hollow of his hand.\" But they drank from it, except a [very] few of them. Then when he had crossed it along with those who believed with him, they said, \"There is no power for us today against Goliath and his soldiers.\" But those who were certain that they would meet Allāh said, \"How many a small company has overcome a large company by permission of Allāh. And Allāh is with the patient.\""}