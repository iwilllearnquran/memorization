{"words": [{"text": "وَقَالَ", "translation": "And said"}, {"text": "لَهُمْ", "translation": "to them"}, {"text": "نَبِيُّهُمْ", "translation": "their Prophet"}, {"text": "إِنَّ", "translation": "Indeed"}, {"text": "ٱللَّهَ", "translation": "Allah"}, {"text": "قَدْ", "translation": "(has) surely"}, {"text": "بَعَثَ", "translation": "raised"}, {"text": "لَكُمْ", "translation": "for you"}, {"text": "طَالُوتَ", "translation": "Talut"}, {"text": "مَلِكًۭا ۚ", "translation": "(as) a king"}, {"text": "قَالُوٓا۟", "translation": "They said"}, {"text": "أَنَّىٰ", "translation": "How"}, {"text": "يَكُونُ", "translation": "can be"}, {"text": "لَهُ", "translation": "for him"}, {"text": "ٱلْمُلْكُ", "translation": "the kingship"}, {"text": "عَلَيْنَا", "translation": "over us"}, {"text": "وَنَحْنُ", "translation": "while we"}, {"text": "أَحَقُّ", "translation": "(are) more entitled"}, {"text": "بِٱلْمُلْكِ", "translation": "to kingship"}, {"text": "مِنْهُ", "translation": "than him"}, {"text": "وَلَمْ", "translation": "and not"}, {"text": "يُؤْتَ", "translation": "he has been given"}, {"text": "سَعَةًۭ", "translation": "abundance"}, {"text": "مِّنَ", "translation": "of"}, {"text": "ٱلْمَالِ ۚ", "translation": "[the] wealth"}, {"text": "قَالَ", "translation": "He said"}, {"text": "إِنَّ", "translation": "Indeed"}, {"text": "ٱللَّهَ", "translation": "Allah"}, {"text": "ٱصْطَفَىٰهُ", "translation": "has chosen him"}, {"text": "عَلَيْكُمْ", "translation": "over you"}, {"text": "وَزَادَهُۥ", "translation": "and increased him"}, {"text": "بَسْطَةًۭ", "translation": "abundantly"}, {"text": "فِى", "translation": "in"}, {"text": "ٱلْعِلْمِ", "translation": "[the] knowledge"}, {"text": "وَٱلْجِسْمِ ۖ", "translation": "and [the] physique"}, {"text": "وَٱللَّهُ", "translation": "And Allah"}, {"text": "يُؤْتِى", "translation": "gives"}, {"text": "مُلْكَهُۥ", "translation": "His kingdom"}, {"text": "مَن", "translation": "(to) whom"}, {"text": "يَشَآءُ ۚ", "translation": "He wills"}, {"text": "وَٱللَّهُ", "translation": "And Allah"}, {"text": "وَٰسِعٌ", "translation": "(is) All-Encompassing"}, {"text": "عَلِيمٌۭ", "translation": "All-Knowing"}], "sahih": "And their prophet said to them, \"Indeed, Allāh has sent to you Saul as a king.\" They said, \"How can he have kingship over us while we are more worthy of kingship than him and he has not been given any measure of wealth?\" He said, \"Indeed, Allāh has chosen him over you and has increased him abundantly in knowledge and stature. And Allāh gives His sovereignty to whom He wills. And Allāh is all-Encompassing [in favor] and Knowing.\""}