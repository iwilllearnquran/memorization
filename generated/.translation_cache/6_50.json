{"words": [{"text": "قُل", "translation": "Say"}, {"text": "لَّآ", "translation": "Not"}, {"text": "أَقُولُ", "translation": "(do) I say"}, {"text": "لَكُمْ", "translation": "to you"}, {"text": "عِندِى", "translation": "(that) with me"}, {"text": "خَزَآئِنُ", "translation": "(are the) treasures"}, {"text": "ٱللَّهِ", "translation": "(of) Allah"}, {"text": "وَلَآ", "translation": "and not"}, {"text": "أَعْلَمُ", "translation": "(that) I know"}, {"text": "ٱلْغَيْبَ", "translation": "the unseen"}, {"text": "وَلَآ", "translation": "and not"}, {"text": "أَقُولُ", "translation": "I say"}, {"text": "لَكُمْ", "translation": "to you"}, {"text": "إِنِّى", "translation": "that I (am)"}, {"text": "مَلَكٌ ۖ", "translation": "an Angel"}, {"text": "إِنْ", "translation": "Not"}, {"text": "أَتَّبِعُ", "translation": "(do) I follow"}, {"text": "إِلَّا", "translation": "except"}, {"text": "مَا", "translation": "what"}, {"text": "يُوحَىٰٓ", "translation": "is revealed"}, {"text": "إِلَىَّ ۚ", "translation": "to me"}, {"text": "قُلْ", "translation": "Say"}, {"text": "هَلْ", "translation": "Can"}, {"text": "يَسْتَوِى", "translation": "be equal"}, {"text": "ٱلْأَعْمَىٰ", "translation": "the blind"}, {"text": "وَٱلْبَصِيرُ ۚ", "translation": "and the seeing one"}, {"text": "أَفَلَا", "translation": "Then will not"}, {"text": "تَتَفَكَّرُونَ", "translation": "you give thought"}], "sahih": "Say, [O Muḥammad], \"I do not tell you that I have the depositories [containing the provision] of Allāh or that I know the unseen, nor do I tell you that I am an angel. I only follow what is revealed to me.\" Say, \"Is the blind equivalent to the seeing? Then will you not give thought?\""}