{"words": [{"text": "يَـٰبَنِىٓ", "translation": "O Children"}, {"text": "إِسْرَٰٓءِيلَ", "translation": "(of) Israel"}, {"text": "ٱذْكُرُوا۟", "translation": "Remember"}, {"text": "نِعْمَتِىَ", "translation": "My Favor"}, {"text": "ٱلَّتِىٓ", "translation": "which"}, {"text": "أَنْعَمْتُ", "translation": "I bestowed"}, {"text": "عَلَيْكُمْ", "translation": "upon you"}, {"text": "وَأَوْفُوا۟", "translation": "and fulfill"}, {"text": "بِعَهْدِىٓ", "translation": "My Covenant"}, {"text": "أُوفِ", "translation": "I will fulfill"}, {"text": "بِعَهْدِكُمْ", "translation": "your covenant"}, {"text": "وَإِيَّـٰىَ", "translation": "and Me Alone"}, {"text": "فَٱرْهَبُونِ", "translation": "fear [Me]"}], "sahih": "O Children of Israel, remember My favor which I have bestowed upon you and fulfill My covenant [upon you] that I will fulfill your covenant [from Me], and be afraid of [only] Me."}