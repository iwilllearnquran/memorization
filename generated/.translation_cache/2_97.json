{"words": [{"text": "قُلْ", "translation": "Say"}, {"text": "مَن", "translation": "Whoever"}, {"text": "كَانَ", "translation": "is"}, {"text": "عَدُوًّۭا", "translation": "an enemy"}, {"text": "لِّجِبْرِيلَ", "translation": "to Jibreel "}, {"text": "فَإِنَّهُۥ", "translation": "then indeed he"}, {"text": "نَزَّلَهُۥ", "translation": "brought it down"}, {"text": "عَلَىٰ", "translation": "on"}, {"text": "قَلْبِكَ", "translation": "your heart"}, {"text": "بِإِذْنِ", "translation": "by (the) permission"}, {"text": "ٱللَّهِ", "translation": "(of) Allah"}, {"text": "مُصَدِّقًۭا", "translation": "confirming"}, {"text": "لِّمَا", "translation": "what"}, {"text": "بَيْنَ", "translation": "(was)"}, {"text": "يَدَيْهِ", "translation": "before it"}, {"text": "وَهُدًۭى", "translation": "and a guidance"}, {"text": "وَبُشْرَىٰ", "translation": "and glad tiding(s)"}, {"text": "لِلْمُؤْمِنِينَ", "translation": "for the believers"}], "sahih": "Say, \"Whoever is an enemy to Gabriel - it is [none but] he who has brought it [i.e., the Qur’ān] down upon your heart, [O Muḥammad], by permission of Allāh, confirming that which was before it and as guidance and good tidings for the believers.\""}