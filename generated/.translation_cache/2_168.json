{"words": [{"text": "يَـٰٓأَيُّهَا", "translation": "O"}, {"text": "ٱلنَّاسُ", "translation": "mankind"}, {"text": "كُلُوا۟", "translation": "Eat"}, {"text": "مِمَّا", "translation": "of what"}, {"text": "فِى", "translation": "(is) in"}, {"text": "ٱلْأَرْضِ", "translation": "the earth"}, {"text": "حَلَـٰلًۭا", "translation": "lawful"}, {"text": "طَيِّبًۭا", "translation": "(and) good"}, {"text": "وَلَا", "translation": "And (do) not"}, {"text": "تَتَّبِعُوا۟", "translation": "follow"}, {"text": "خُطُوَٰتِ", "translation": "(the) footsteps (of)"}, {"text": "ٱلشَّيْطَـٰنِ ۚ", "translation": "the Shaitaan"}, {"text": "إِنَّهُۥ", "translation": "Indeed, he"}, {"text": "لَكُمْ", "translation": "(is) to you"}, {"text": "عَدُوٌّۭ", "translation": "an enemy"}, {"text": "مُّبِينٌ", "translation": "clear"}], "sahih": "O mankind, eat from whatever is on earth [that is] lawful and good and do not follow the footsteps of Satan. Indeed, he is to you a clear enemy."}