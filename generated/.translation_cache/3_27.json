{"words": [{"text": "تُولِجُ", "translation": "You cause to enter"}, {"text": "ٱلَّيْلَ", "translation": "the night"}, {"text": "فِى", "translation": "in"}, {"text": "ٱلنَّهَارِ", "translation": "the day"}, {"text": "وَتُولِجُ", "translation": "and You cause to enter"}, {"text": "ٱلنَّهَارَ", "translation": "the day"}, {"text": "فِى", "translation": "in"}, {"text": "ٱلَّيْلِ ۖ", "translation": "the night"}, {"text": "وَتُخْرِجُ", "translation": "and You bring forth"}, {"text": "ٱلْحَىَّ", "translation": "the living"}, {"text": "مِنَ", "translation": "from"}, {"text": "ٱلْمَيِّتِ", "translation": "the dead"}, {"text": "وَتُخْرِجُ", "translation": "and You bring forth"}, {"text": "ٱلْمَيِّتَ", "translation": "the dead"}, {"text": "مِنَ", "translation": "from"}, {"text": "ٱلْحَىِّ ۖ", "translation": "the living"}, {"text": "وَتَرْزُقُ", "translation": "and You give provision"}, {"text": "مَن", "translation": "(to) whom"}, {"text": "تَشَآءُ", "translation": "You will"}, {"text": "بِغَيْرِ", "translation": "without"}, {"text": "حِسَابٍۢ", "translation": "measure"}], "sahih": "You cause the night to enter the day, and You cause the day to enter the night; and You bring the living out of the dead, and You bring the dead out of the living. And You give provision to whom You will without account [i.e., limit or measure].\""}