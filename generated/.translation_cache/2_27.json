{"words": [{"text": "ٱلَّذِينَ", "translation": "Those who"}, {"text": "يَنقُضُونَ", "translation": "break"}, {"text": "عَهْدَ", "translation": "(the) Covenant"}, {"text": "ٱللَّهِ", "translation": "(of) Allah"}, {"text": "مِنۢ", "translation": "from"}, {"text": "بَعْدِ", "translation": "after"}, {"text": "مِيثَـٰقِهِۦ", "translation": "its ratification"}, {"text": "وَيَقْطَعُونَ", "translation": "and [they] cut"}, {"text": "مَآ", "translation": "what"}, {"text": "أَمَرَ", "translation": "has ordered"}, {"text": "ٱللَّهُ", "translation": "Allah"}, {"text": "بِهِۦٓ", "translation": "it"}, {"text": "أَن", "translation": "to"}, {"text": "يُوصَلَ", "translation": "be joined"}, {"text": "وَيُفْسِدُونَ", "translation": "and [they] spread corruption"}, {"text": "فِى", "translation": "in"}, {"text": "ٱلْأَرْضِ ۚ", "translation": "the earth"}, {"text": "أُو۟لَـٰٓئِكَ", "translation": "Those"}, {"text": "هُمُ", "translation": "they"}, {"text": "ٱلْخَـٰسِرُونَ", "translation": "(are) the losers"}], "sahih": "Who break the covenant of Allāh after contracting it and sever that which Allāh has ordered to be joined and cause corruption on earth. It is those who are the losers."}