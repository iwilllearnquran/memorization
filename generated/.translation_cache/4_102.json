{"words": [{"text": "وَإِذَا", "translation": "And when"}, {"text": "كُنتَ", "translation": "you are"}, {"text": "فِيهِمْ", "translation": "among them"}, {"text": "فَأَقَمْتَ", "translation": "and you lead"}, {"text": "لَهُمُ", "translation": "for them"}, {"text": "ٱلصَّلَوٰةَ", "translation": "the prayer"}, {"text": "فَلْتَقُمْ", "translation": "then let stand"}, {"text": "طَآئِفَةٌۭ", "translation": "a group"}, {"text": "مِّنْهُم", "translation": "of them"}, {"text": "مَّعَكَ", "translation": "with you"}, {"text": "وَلْيَأْخُذُوٓا۟", "translation": "and let them take"}, {"text": "أَسْلِحَتَهُمْ", "translation": "their arms"}, {"text": "فَإِذَا", "translation": "Then when"}, {"text": "سَجَدُوا۟", "translation": "they have prostrated"}, {"text": "فَلْيَكُونُوا۟", "translation": "then let them be"}, {"text": "مِن", "translation": "from"}, {"text": "وَرَآئِكُمْ", "translation": "behind you"}, {"text": "وَلْتَأْتِ", "translation": "and let come (forward)"}, {"text": "طَآئِفَةٌ", "translation": "a group "}, {"text": "أُخْرَىٰ", "translation": "other"}, {"text": "لَمْ", "translation": "(which has) not"}, {"text": "يُصَلُّوا۟", "translation": "prayed"}, {"text": "فَلْيُصَلُّوا۟", "translation": "and let them pray"}, {"text": "مَعَكَ", "translation": "with you"}, {"text": "وَلْيَأْخُذُوا۟", "translation": "and let them take"}, {"text": "حِذْرَهُمْ", "translation": "their precautions"}, {"text": "وَأَسْلِحَتَهُمْ ۗ", "translation": "and their arms"}, {"text": "وَدَّ", "translation": "Wished"}, {"text": "ٱلَّذِينَ", "translation": "those who"}, {"text": "كَفَرُوا۟", "translation": "disbelieved"}, {"text": "لَوْ", "translation": "if"}, {"text": "تَغْفُلُونَ", "translation": "you neglect"}, {"text": "عَنْ", "translation": "[about]"}, {"text": "أَسْلِحَتِكُمْ", "translation": "your arms"}, {"text": "وَأَمْتِعَتِكُمْ", "translation": "and your baggage"}, {"text": "فَيَمِيلُونَ", "translation": "so (that) they (can) assault"}, {"text": "عَلَيْكُم", "translation": "[upon] you"}, {"text": "مَّيْلَةًۭ", "translation": "(in) an attack"}, {"text": "وَٰحِدَةًۭ ۚ", "translation": "single"}, {"text": "وَلَا", "translation": "But (there is) no"}, {"text": "جُنَاحَ", "translation": "blame"}, {"text": "عَلَيْكُمْ", "translation": "upon you"}, {"text": "إِن", "translation": "if"}, {"text": "كَانَ", "translation": "was"}, {"text": "بِكُمْ", "translation": "with you"}, {"text": "أَذًۭى", "translation": "any trouble"}, {"text": "مِّن", "translation": "(because) of"}, {"text": "مَّطَرٍ", "translation": "rain"}, {"text": "أَوْ", "translation": "or"}, {"text": "كُنتُم", "translation": "you are"}, {"text": "مَّرْضَىٰٓ", "translation": "sick"}, {"text": "أَن", "translation": "that"}, {"text": "تَضَعُوٓا۟", "translation": "you lay down"}, {"text": "أَسْلِحَتَكُمْ ۖ", "translation": "your arms"}, {"text": "وَخُذُوا۟", "translation": "but take"}, {"text": "حِذْرَكُمْ ۗ", "translation": "your precautions"}, {"text": "إِنَّ", "translation": "Indeed"}, {"text": "ٱللَّهَ", "translation": "Allah"}, {"text": "أَعَدَّ", "translation": "has prepared"}, {"text": "لِلْكَـٰفِرِينَ", "translation": "for the disbelievers"}, {"text": "عَذَابًۭا", "translation": "a punishment"}, {"text": "مُّهِينًۭا", "translation": "humiliating"}], "sahih": "And when you [i.e., the commander of an army] are among them and lead them in prayer,1 let a group of them stand [in prayer] with you and let them carry their arms. And when they have prostrated, let them be [in position] behind you and have the other group come forward which has not [yet] prayed and let them pray with you, taking precaution and carrying their arms. Those who disbelieve wish that you would neglect your weapons and your baggage so they could come down upon you in one [single] attack. But there is no blame upon you, if you are troubled by rain or are ill, for putting down your arms, but take precaution. Indeed, Allāh has prepared for the disbelievers a humiliating punishment."}