{"words": [{"text": "ٱلطَّلَـٰقُ", "translation": "The divorce"}, {"text": "مَرَّتَانِ ۖ", "translation": "(is) twice"}, {"text": "فَإِمْسَاكٌۢ", "translation": "Then to retain"}, {"text": "بِمَعْرُوفٍ", "translation": "in a reasonable manner"}, {"text": "أَوْ", "translation": "or"}, {"text": "تَسْرِيحٌۢ", "translation": "to release (her)"}, {"text": "بِإِحْسَـٰنٍۢ ۗ", "translation": "with kindness"}, {"text": "وَلَا", "translation": "And (it is) not"}, {"text": "يَحِلُّ", "translation": "lawful"}, {"text": "لَكُمْ", "translation": "for you"}, {"text": "أَن", "translation": "that"}, {"text": "تَأْخُذُوا۟", "translation": "you take (back)"}, {"text": "مِمَّآ", "translation": "whatever"}, {"text": "ءَاتَيْتُمُوهُنَّ", "translation": "you have given them"}, {"text": "شَيْـًٔا", "translation": "anything"}, {"text": "إِلَّآ", "translation": "except"}, {"text": "أَن", "translation": "if"}, {"text": "يَخَافَآ", "translation": "both fear"}, {"text": "أَلَّا", "translation": "that not"}, {"text": "يُقِيمَا", "translation": "they both (can) keep"}, {"text": "حُدُودَ", "translation": "(the) limits"}, {"text": "ٱللَّهِ ۖ", "translation": "(of) Allah"}, {"text": "فَإِنْ", "translation": "But if"}, {"text": "خِفْتُمْ", "translation": "you fear"}, {"text": "أَلَّا", "translation": "that not"}, {"text": "يُقِيمَا", "translation": "they both (can) keep"}, {"text": "حُدُودَ", "translation": "(the) limits"}, {"text": "ٱللَّهِ", "translation": "(of) Allah"}, {"text": "فَلَا", "translation": "then (there is) no"}, {"text": "جُنَاحَ", "translation": "sin"}, {"text": "عَلَيْهِمَا", "translation": "on both of them"}, {"text": "فِيمَا", "translation": "in what"}, {"text": "ٱفْتَدَتْ", "translation": "she ransoms"}, {"text": "بِهِۦ ۗ", "translation": "concerning it"}, {"text": "تِلْكَ", "translation": "These"}, {"text": "حُدُودُ", "translation": "(are the) limits"}, {"text": "ٱللَّهِ", "translation": "(of) Allah"}, {"text": "فَلَا", "translation": "so (do) not"}, {"text": "تَعْتَدُوهَا ۚ", "translation": "transgress them"}, {"text": "وَمَن", "translation": "And whoever"}, {"text": "يَتَعَدَّ", "translation": "transgresses"}, {"text": "حُدُودَ", "translation": "(the) limits"}, {"text": "ٱللَّهِ", "translation": "(of) Allah"}, {"text": "فَأُو۟لَـٰٓئِكَ", "translation": "then those "}, {"text": "هُمُ", "translation": "they"}, {"text": "ٱلظَّـٰلِمُونَ", "translation": "(are) the wrongdoers"}], "sahih": "Divorce is twice. Then [after that], either keep [her] in an acceptable manner or release [her] with good treatment. And it is not lawful for you to take anything of what you have given them unless both fear that they will not be able to keep [within] the limits of Allāh.1 But if you fear that they will not keep [within] the limits of Allāh, then there is no blame upon either of them concerning that by which she ransoms herself. These are the limits of Allāh, so do not transgress them. And whoever transgresses the limits of Allāh - it is those who are the wrongdoers [i.e., the unjust]."}