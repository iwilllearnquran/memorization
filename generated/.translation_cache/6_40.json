{"words": [{"text": "قُلْ", "translation": "Say"}, {"text": "أَرَءَيْتَكُمْ", "translation": "Have you seen"}, {"text": "إِنْ", "translation": "if"}, {"text": "أَتَىٰكُمْ", "translation": "(there) came to you"}, {"text": "عَذَابُ", "translation": "punishment"}, {"text": "ٱللَّهِ", "translation": "(of) Allah"}, {"text": "أَوْ", "translation": "or"}, {"text": "أَتَتْكُمُ", "translation": "(there) came to you"}, {"text": "ٱلسَّاعَةُ", "translation": "the Hour "}, {"text": "أَغَيْرَ", "translation": "is it other"}, {"text": "ٱللَّهِ", "translation": "(than) Allah"}, {"text": "تَدْعُونَ", "translation": "you call"}, {"text": "إِن", "translation": "if"}, {"text": "كُنتُمْ", "translation": "you are"}, {"text": "صَـٰدِقِينَ", "translation": "truthful"}], "sahih": "Say, \"Have you considered:1 if there came to you the punishment of Allāh or there came to you the Hour - is it other than Allāh you would invoke, if you should be truthful?\""}