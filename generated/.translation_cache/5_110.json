{"words": [{"text": "إِذْ", "translation": "When"}, {"text": "قَالَ", "translation": "said"}, {"text": "ٱللَّهُ", "translation": "Allah"}, {"text": "يَـٰعِيسَى", "translation": "O Isa"}, {"text": "ٱبْنَ", "translation": "son"}, {"text": "مَرْيَمَ", "translation": "(of) Maryam"}, {"text": "ٱذْكُرْ", "translation": "Remember"}, {"text": "نِعْمَتِى", "translation": "My Favor"}, {"text": "عَلَيْكَ", "translation": "upon you"}, {"text": "وَعَلَىٰ", "translation": "and upon"}, {"text": "وَٰلِدَتِكَ", "translation": "your mother"}, {"text": "إِذْ", "translation": "when"}, {"text": "أَيَّدتُّكَ", "translation": "I strengthened you"}, {"text": "بِرُوحِ", "translation": "with (the) Spirit"}, {"text": "ٱلْقُدُسِ", "translation": "the Holy"}, {"text": "تُكَلِّمُ", "translation": "you spoke"}, {"text": "ٱلنَّاسَ", "translation": "(to) the people"}, {"text": "فِى", "translation": "in"}, {"text": "ٱلْمَهْدِ", "translation": "the cradle"}, {"text": "وَكَهْلًۭا ۖ", "translation": "and (in) maturity"}, {"text": "وَإِذْ", "translation": "And when"}, {"text": "عَلَّمْتُكَ", "translation": "I taught you"}, {"text": "ٱلْكِتَـٰبَ", "translation": "the Book"}, {"text": "وَٱلْحِكْمَةَ", "translation": "and the wisdom"}, {"text": "وَٱلتَّوْرَىٰةَ", "translation": "and the Taurat"}, {"text": "وَٱلْإِنجِيلَ ۖ", "translation": "and the Injeel"}, {"text": "وَإِذْ", "translation": "and when"}, {"text": "تَخْلُقُ", "translation": "you make"}, {"text": "مِنَ", "translation": "from"}, {"text": "ٱلطِّينِ", "translation": "the clay"}, {"text": "كَهَيْـَٔةِ", "translation": "like the shape"}, {"text": "ٱلطَّيْرِ", "translation": "(of) the bird"}, {"text": "بِإِذْنِى", "translation": "by My permission"}, {"text": "فَتَنفُخُ", "translation": "then you breath"}, {"text": "فِيهَا", "translation": "into it"}, {"text": "فَتَكُونُ", "translation": "and it becomes"}, {"text": "طَيْرًۢا", "translation": "a bird"}, {"text": "بِإِذْنِى ۖ", "translation": "by My permission"}, {"text": "وَتُبْرِئُ", "translation": "and you heal"}, {"text": "ٱلْأَكْمَهَ", "translation": "the born blind"}, {"text": "وَٱلْأَبْرَصَ", "translation": "and the leper"}, {"text": "بِإِذْنِى ۖ", "translation": "by My permission"}, {"text": "وَإِذْ", "translation": "and when"}, {"text": "تُخْرِجُ", "translation": "you bring forth"}, {"text": "ٱلْمَوْتَىٰ", "translation": "the dead"}, {"text": "بِإِذْنِى ۖ", "translation": "by My permission"}, {"text": "وَإِذْ", "translation": "And when"}, {"text": "كَفَفْتُ", "translation": "I restrained"}, {"text": "بَنِىٓ", "translation": "(the) Children"}, {"text": "إِسْرَٰٓءِيلَ", "translation": "(of) Israel"}, {"text": "عَنكَ", "translation": "from you"}, {"text": "إِذْ", "translation": "when"}, {"text": "جِئْتَهُم", "translation": "you came to them"}, {"text": "بِٱلْبَيِّنَـٰتِ", "translation": "with the clear proofs"}, {"text": "فَقَالَ", "translation": "then said"}, {"text": "ٱلَّذِينَ", "translation": "those who"}, {"text": "كَفَرُوا۟", "translation": "disbelieved"}, {"text": "مِنْهُمْ", "translation": "among them"}, {"text": "إِنْ", "translation": "Not"}, {"text": "هَـٰذَآ", "translation": "(is) this"}, {"text": "إِلَّا", "translation": "but"}, {"text": "سِحْرٌۭ", "translation": "magic"}, {"text": "مُّبِينٌۭ", "translation": "clear"}], "sahih": "[The Day] when Allāh will say, \"O Jesus, Son of Mary, remember My favor upon you and upon your mother when I supported you with the Pure Spirit [i.e., the angel Gabriel] and you spoke to the people in the cradle and in maturity; and [remember] when I taught you writing and wisdom and the Torah and the Gospel; and when you designed from clay [what was] like the form of a bird with My permission, then you breathed into it, and it became a bird with My permission; and you healed the blind [from birth] and the leper with My permission; and when you brought forth the dead with My permission; and when I restrained the Children of Israel from [killing] you when you came to them with clear proofs and those who disbelieved among them said, \"This is not but obvious magic.\""}