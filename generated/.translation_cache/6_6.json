{"words": [{"text": "أَلَمْ", "translation": "Did not"}, {"text": "يَرَوْا۟", "translation": "they see"}, {"text": "كَمْ", "translation": "how many"}, {"text": "أَهْلَكْنَا", "translation": "We destroyed"}, {"text": "مِن", "translation": "from"}, {"text": "قَبْلِهِم", "translation": "before them"}, {"text": "مِّن", "translation": "of"}, {"text": "قَرْنٍۢ", "translation": "generations"}, {"text": "مَّكَّنَّـٰهُمْ", "translation": "We had established them"}, {"text": "فِى", "translation": "in"}, {"text": "ٱلْأَرْضِ", "translation": "the earth"}, {"text": "مَا", "translation": "what"}, {"text": "لَمْ", "translation": "not"}, {"text": "نُمَكِّن", "translation": "We (have) established"}, {"text": "لَّكُمْ", "translation": "for you"}, {"text": "وَأَرْسَلْنَا", "translation": "And We sent"}, {"text": "ٱلسَّمَآءَ", "translation": "(rain from) the sky"}, {"text": "عَلَيْهِم", "translation": "upon them"}, {"text": "مِّدْرَارًۭا", "translation": "showering abundantly"}, {"text": "وَجَعَلْنَا", "translation": "and We made"}, {"text": "ٱلْأَنْهَـٰرَ", "translation": "the rivers"}, {"text": "تَجْرِى", "translation": "flow"}, {"text": "مِن", "translation": "from"}, {"text": "تَحْتِهِمْ", "translation": "underneath them"}, {"text": "فَأَهْلَكْنَـٰهُم", "translation": "Then We destroyed them"}, {"text": "بِذُنُوبِهِمْ", "translation": "for their sins"}, {"text": "وَأَنشَأْنَا", "translation": "and We raised"}, {"text": "مِنۢ", "translation": "from"}, {"text": "بَعْدِهِمْ", "translation": "after them"}, {"text": "قَرْنًا", "translation": "generations"}, {"text": "ءَاخَرِينَ", "translation": "other"}], "sahih": "Have they not seen how many generations We destroyed before them which We had established upon the earth as We have not established you? And We sent [rain from] the sky upon them in showers and made rivers flow beneath them; then We destroyed them for their sins and brought forth after them a generation of others."}