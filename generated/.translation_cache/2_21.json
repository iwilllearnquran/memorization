{"words": [{"text": "يَـٰٓأَيُّهَا", "translation": "O"}, {"text": "ٱلنَّاسُ", "translation": "mankind"}, {"text": "ٱعْبُدُوا۟", "translation": "worship"}, {"text": "رَبَّكُمُ", "translation": "your Lord"}, {"text": "ٱلَّذِى", "translation": "the One Who"}, {"text": "خَلَقَكُمْ", "translation": "created you"}, {"text": "وَٱلَّذِينَ", "translation": "and those"}, {"text": "مِن", "translation": "from"}, {"text": "قَبْلِكُمْ", "translation": "before you"}, {"text": "لَعَلَّكُمْ", "translation": "so that you may"}, {"text": "تَتَّقُونَ", "translation": "become righteous"}], "sahih": "O mankind, worship your Lord, who created you and those before you, that you may become righteous -"}