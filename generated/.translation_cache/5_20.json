{"words": [{"text": "وَإِذْ", "translation": "And when"}, {"text": "قَالَ", "translation": "said"}, {"text": "مُوسَىٰ", "translation": "Musa"}, {"text": "لِقَوْمِهِۦ", "translation": "to his people"}, {"text": "يَـٰقَوْمِ", "translation": "O my people"}, {"text": "ٱذْكُرُوا۟", "translation": "remember"}, {"text": "نِعْمَةَ", "translation": "(the) Favor"}, {"text": "ٱللَّهِ", "translation": "(of) Allah"}, {"text": "عَلَيْكُمْ", "translation": "upon you"}, {"text": "إِذْ", "translation": "when"}, {"text": "جَعَلَ", "translation": "He placed"}, {"text": "فِيكُمْ", "translation": "among you"}, {"text": "أَنۢبِيَآءَ", "translation": "Prophets"}, {"text": "وَجَعَلَكُم", "translation": "and made you"}, {"text": "مُّلُوكًۭا", "translation": "kings"}, {"text": "وَءَاتَىٰكُم", "translation": "and He gave you"}, {"text": "مَّا", "translation": "what"}, {"text": "لَمْ", "translation": "not"}, {"text": "يُؤْتِ", "translation": "He (had) given"}, {"text": "أَحَدًۭا", "translation": "(to) anyone"}, {"text": "مِّنَ", "translation": "from"}, {"text": "ٱلْعَـٰلَمِينَ", "translation": "the worlds"}], "sahih": "And [mention, O Muḥammad], when Moses said to his people, \"O my people, remember the favor of Allāh upon you when He appointed among you prophets and made you possessors1 and gave you that which He had not given anyone among the worlds."}