{"words": [{"text": "ٱلْحَقُّ", "translation": "The truth"}, {"text": "مِن", "translation": "(is) from"}, {"text": "رَّبِّكَ", "translation": "your Lord"}, {"text": "فَلَا", "translation": "so (do) not"}, {"text": "تَكُن", "translation": "be"}, {"text": "مِّنَ", "translation": "among"}, {"text": "ٱلْمُمْتَرِينَ", "translation": "the doubters"}], "sahih": "The truth is from your Lord, so do not be among the doubters."}