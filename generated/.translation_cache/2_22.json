{"words": [{"text": "ٱلَّذِى", "translation": "The One Who"}, {"text": "جَعَلَ", "translation": "made"}, {"text": "لَكُمُ", "translation": "for you"}, {"text": "ٱلْأَرْضَ", "translation": "the earth"}, {"text": "فِرَٰشًۭا", "translation": "a resting place"}, {"text": "وَٱلسَّمَآءَ", "translation": "and the sky"}, {"text": "بِنَآءًۭ", "translation": "a canopy"}, {"text": "وَأَنزَلَ", "translation": "and sent down"}, {"text": "مِنَ", "translation": "from"}, {"text": "ٱلسَّمَآءِ", "translation": "the sky"}, {"text": "مَآءًۭ", "translation": "water"}, {"text": "فَأَخْرَجَ", "translation": "then brought forth"}, {"text": "بِهِۦ", "translation": "therewith"}, {"text": "مِنَ", "translation": "[of]"}, {"text": "ٱلثَّمَرَٰتِ", "translation": "the fruits"}, {"text": "رِزْقًۭا", "translation": "(as) provision"}, {"text": "لَّكُمْ ۖ", "translation": "for you"}, {"text": "فَلَا", "translation": "So (do) not"}, {"text": "تَجْعَلُوا۟", "translation": "set up"}, {"text": "لِلَّهِ", "translation": "to Allah"}, {"text": "أَندَادًۭا", "translation": "rivals"}, {"text": "وَأَنتُمْ", "translation": "while you"}, {"text": "تَعْلَمُونَ", "translation": "[you] know"}], "sahih": "[He] who made for you the earth a bed [spread out] and the sky a ceiling and sent down from the sky, rain and brought forth thereby fruits as provision for you. So do not attribute to Allāh equals while you know [that there is nothing similar to Him]."}