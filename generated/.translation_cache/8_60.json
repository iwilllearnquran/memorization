{"words": [{"text": "وَأَعِدُّوا۟", "translation": "And prepare"}, {"text": "لَهُم", "translation": "for them"}, {"text": "مَّا", "translation": "whatever"}, {"text": "ٱسْتَطَعْتُم", "translation": "you able (to)"}, {"text": "مِّن", "translation": "of"}, {"text": "قُوَّةٍۢ", "translation": "force"}, {"text": "وَمِن", "translation": "and of"}, {"text": "رِّبَاطِ", "translation": "tethered"}, {"text": "ٱلْخَيْلِ", "translation": "horses"}, {"text": "تُرْهِبُونَ", "translation": "(to) terrify"}, {"text": "بِهِۦ", "translation": "therewith"}, {"text": "عَدُوَّ", "translation": "(the) enemy"}, {"text": "ٱللَّهِ", "translation": "(of) Allah"}, {"text": "وَعَدُوَّكُمْ", "translation": "and your enemy"}, {"text": "وَءَاخَرِينَ", "translation": "and others"}, {"text": "مِن", "translation": "from"}, {"text": "دُونِهِمْ", "translation": "besides them"}, {"text": "لَا", "translation": "not"}, {"text": "تَعْلَمُونَهُمُ", "translation": "(do) you know them"}, {"text": "ٱللَّهُ", "translation": "(but) Allah"}, {"text": "يَعْلَمُهُمْ ۚ", "translation": "knows them"}, {"text": "وَمَا", "translation": "And whatever"}, {"text": "تُنفِقُوا۟", "translation": "you spend"}, {"text": "مِن", "translation": "from"}, {"text": "شَىْءٍۢ", "translation": "(any) thing"}, {"text": "فِى", "translation": "in"}, {"text": "سَبِيلِ", "translation": "(the) way"}, {"text": "ٱللَّهِ", "translation": "(of) Allah"}, {"text": "يُوَفَّ", "translation": "it will be fully repaid"}, {"text": "إِلَيْكُمْ", "translation": "to you"}, {"text": "وَأَنتُمْ", "translation": "and you"}, {"text": "لَا", "translation": "(will) not"}, {"text": "تُظْلَمُونَ", "translation": "be wronged"}], "sahih": "And prepare against them whatever you are able of power and of steeds of war1 by which you may terrify the enemy of Allāh and your enemy and others besides them whom you do not know [but] whom Allāh knows. And whatever you spend in the cause of Allāh will be fully repaid to you, and you will not be wronged."}