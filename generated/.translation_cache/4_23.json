{"words": [{"text": "حُرِّمَتْ", "translation": "Forbidden"}, {"text": "عَلَيْكُمْ", "translation": "to you"}, {"text": "أُمَّهَـٰتُكُمْ", "translation": "(are) your mothers"}, {"text": "وَبَنَاتُكُمْ", "translation": "and your daughters"}, {"text": "وَأَخَوَٰتُكُمْ", "translation": "and your sisters"}, {"text": "وَعَمَّـٰتُكُمْ", "translation": "and your father's sisters"}, {"text": "وَخَـٰلَـٰتُكُمْ", "translation": "and your mother's sisters"}, {"text": "وَبَنَاتُ", "translation": "and daughters"}, {"text": "ٱلْأَخِ", "translation": "(of) brothers"}, {"text": "وَبَنَاتُ", "translation": "and daughters"}, {"text": "ٱلْأُخْتِ", "translation": "(of) sisters"}, {"text": "وَأُمَّهَـٰتُكُمُ", "translation": "and (the) mothers"}, {"text": "ٱلَّـٰتِىٓ", "translation": "who"}, {"text": "أَرْضَعْنَكُمْ", "translation": "nursed you"}, {"text": "وَأَخَوَٰتُكُم", "translation": "and your sisters"}, {"text": "مِّنَ", "translation": "from"}, {"text": "ٱلرَّضَـٰعَةِ", "translation": "the nursing"}, {"text": "وَأُمَّهَـٰتُ", "translation": "and mothers"}, {"text": "نِسَآئِكُمْ", "translation": "(of) your wives"}, {"text": "وَرَبَـٰٓئِبُكُمُ", "translation": "and your step daughters"}, {"text": "ٱلَّـٰتِى", "translation": "who"}, {"text": "فِى", "translation": "(are) in"}, {"text": "حُجُورِكُم", "translation": "your guardianship"}, {"text": "مِّن", "translation": "of"}, {"text": "نِّسَآئِكُمُ", "translation": "your women"}, {"text": "ٱلَّـٰتِى", "translation": "whom"}, {"text": "دَخَلْتُم", "translation": "you had relations"}, {"text": "بِهِنَّ", "translation": "with them"}, {"text": "فَإِن", "translation": "but if"}, {"text": "لَّمْ", "translation": "not"}, {"text": "تَكُونُوا۟", "translation": "you had"}, {"text": "دَخَلْتُم", "translation": "relations"}, {"text": "بِهِنَّ", "translation": "with them"}, {"text": "فَلَا", "translation": "then (there is) no"}, {"text": "جُنَاحَ", "translation": "sin"}, {"text": "عَلَيْكُمْ", "translation": "on you"}, {"text": "وَحَلَـٰٓئِلُ", "translation": "And wives"}, {"text": "أَبْنَآئِكُمُ", "translation": "(of) your sons"}, {"text": "ٱلَّذِينَ", "translation": "those who"}, {"text": "مِنْ", "translation": "(are) from"}, {"text": "أَصْلَـٰبِكُمْ", "translation": "your loins"}, {"text": "وَأَن", "translation": "and that"}, {"text": "تَجْمَعُوا۟", "translation": "you gather together"}, {"text": "بَيْنَ", "translation": "[between]"}, {"text": "ٱلْأُخْتَيْنِ", "translation": "two sisters"}, {"text": "إِلَّا", "translation": "except"}, {"text": "مَا", "translation": "what"}, {"text": "قَدْ", "translation": "has"}, {"text": "سَلَفَ ۗ", "translation": "passed before"}, {"text": "إِنَّ", "translation": "Indeed"}, {"text": "ٱللَّهَ", "translation": "Allah"}, {"text": "كَانَ", "translation": "is"}, {"text": "غَفُورًۭا", "translation": "Oft-Forgiving"}, {"text": "رَّحِيمًۭا", "translation": "Most-Merciful"}], "sahih": "Prohibited to you [for marriage] are your mothers, your daughters, your sisters, your father's sisters, your mother's sisters, your brother's daughters, your sister's daughters, your [milk] mothers who nursed you, your sisters through nursing, your wives' mothers, and your step-daughters under your guardianship [born] of your wives unto whom you have gone in. But if you have not gone in unto them, there is no sin upon you. And [also prohibited are] the wives of your sons who are from your [own] loins, and that you take [in marriage] two sisters simultaneously, except for what has already occurred.1 Indeed, Allāh is ever Forgiving and Merciful."}