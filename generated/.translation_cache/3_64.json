{"words": [{"text": "قُلْ", "translation": "Say"}, {"text": "يَـٰٓأَهْلَ", "translation": "O People"}, {"text": "ٱلْكِتَـٰبِ", "translation": "(of) the Book"}, {"text": "تَعَالَوْا۟", "translation": "Come"}, {"text": "إِلَىٰ", "translation": "to"}, {"text": "كَلِمَةٍۢ", "translation": "a word"}, {"text": "سَوَآءٍۭ", "translation": "equitable"}, {"text": "بَيْنَنَا", "translation": "between us"}, {"text": "وَبَيْنَكُمْ", "translation": "and between you "}, {"text": "أَلَّا", "translation": "that not"}, {"text": "نَعْبُدَ", "translation": "we worship"}, {"text": "إِلَّا", "translation": "except"}, {"text": "ٱللَّهَ", "translation": "Allah"}, {"text": "وَلَا", "translation": "and not"}, {"text": "نُشْرِكَ", "translation": "we associate partners"}, {"text": "بِهِۦ", "translation": "with Him "}, {"text": "شَيْـًۭٔا", "translation": "anything"}, {"text": "وَلَا", "translation": "and not"}, {"text": "يَتَّخِذَ", "translation": "take"}, {"text": "بَعْضُنَا", "translation": "some of us"}, {"text": "بَعْضًا", "translation": "(to) others"}, {"text": "أَرْبَابًۭا", "translation": "(as) lords"}, {"text": "مِّن", "translation": "from"}, {"text": "دُونِ", "translation": "besides"}, {"text": "ٱللَّهِ ۚ", "translation": "Allah"}, {"text": "فَإِن", "translation": "Then if"}, {"text": "تَوَلَّوْا۟", "translation": "they turn away"}, {"text": "فَقُولُوا۟", "translation": "then say"}, {"text": "ٱشْهَدُوا۟", "translation": "Bear witness"}, {"text": "بِأَنَّا", "translation": "that we"}, {"text": "مُسْلِمُونَ", "translation": "(are) Muslims"}], "sahih": "Say, \"O People of the Scripture, come to a word that is equitable between us and you - that we will not worship except Allāh and not associate anything with Him and not take one another as lords instead of Allāh.\"1 But if they turn away, then say, \"Bear witness that we are Muslims [submitting to Him].\""}