{"words": [{"text": "ثَمَـٰنِيَةَ", "translation": "Eight"}, {"text": "أَزْوَٰجٍۢ ۖ", "translation": "pairs "}, {"text": "مِّنَ", "translation": "of"}, {"text": "ٱلضَّأْنِ", "translation": "the sheep"}, {"text": "ٱثْنَيْنِ", "translation": "two"}, {"text": "وَمِنَ", "translation": "and of"}, {"text": "ٱلْمَعْزِ", "translation": "the goats"}, {"text": "ٱثْنَيْنِ ۗ", "translation": "two"}, {"text": "قُلْ", "translation": "Say"}, {"text": "ءَآلذَّكَرَيْنِ", "translation": "(Are) the two males"}, {"text": "حَرَّمَ", "translation": "He has forbidden"}, {"text": "أَمِ", "translation": "or"}, {"text": "ٱلْأُنثَيَيْنِ", "translation": "the two females"}, {"text": "أَمَّا", "translation": "or what"}, {"text": "ٱشْتَمَلَتْ", "translation": "contains"}, {"text": "عَلَيْهِ", "translation": "[in it]"}, {"text": "أَرْحَامُ", "translation": "(the) wombs"}, {"text": "ٱلْأُنثَيَيْنِ ۖ", "translation": "(of) the two females"}, {"text": "نَبِّـُٔونِى", "translation": "Inform me"}, {"text": "بِعِلْمٍ", "translation": "with knowledge"}, {"text": "إِن", "translation": "if"}, {"text": "كُنتُمْ", "translation": "you are"}, {"text": "صَـٰدِقِينَ", "translation": "truthful"}], "sahih": "[They are] eight mates - of the sheep, two and of the goats, two. Say, \"Is it the two males He has forbidden or the two females or that which the wombs of the two females contain? Inform me with knowledge, if you should be truthful.\""}