{"words": [{"text": "وَدَّ", "translation": "Wish[ed]"}, {"text": "كَثِيرٌۭ", "translation": "many"}, {"text": "مِّنْ", "translation": "from"}, {"text": "أَهْلِ", "translation": "(the) People"}, {"text": "ٱلْكِتَـٰبِ", "translation": "(of) the Book"}, {"text": "لَوْ", "translation": "if"}, {"text": "يَرُدُّونَكُم", "translation": "they could turn you back"}, {"text": "مِّنۢ", "translation": "from"}, {"text": "بَعْدِ", "translation": "after"}, {"text": "إِيمَـٰنِكُمْ", "translation": "your (having) faith"}, {"text": "كُفَّارًا", "translation": "(to) disbelievers"}, {"text": "حَسَدًۭا", "translation": "(out of) jealousy"}, {"text": "مِّنْ", "translation": "from"}, {"text": "عِندِ", "translation": "(of)"}, {"text": "أَنفُسِهِم", "translation": "themselves"}, {"text": "مِّنۢ", "translation": "(even) from"}, {"text": "بَعْدِ", "translation": "after"}, {"text": "مَا", "translation": "[what]"}, {"text": "تَبَيَّنَ", "translation": "became clear"}, {"text": "لَهُمُ", "translation": "to them"}, {"text": "ٱلْحَقُّ ۖ", "translation": "the truth"}, {"text": "فَٱعْفُوا۟", "translation": "So forgive"}, {"text": "وَٱصْفَحُوا۟", "translation": "and overlook"}, {"text": "حَتَّىٰ", "translation": "until"}, {"text": "يَأْتِىَ", "translation": "brings"}, {"text": "ٱللَّهُ", "translation": "Allah"}, {"text": "بِأَمْرِهِۦٓ ۗ", "translation": "His Command"}, {"text": "إِنَّ", "translation": "Indeed"}, {"text": "ٱللَّهَ", "translation": "Allah"}, {"text": "عَلَىٰ", "translation": "on"}, {"text": "كُلِّ", "translation": "every"}, {"text": "شَىْءٍۢ", "translation": "thing"}, {"text": "قَدِيرٌۭ", "translation": "(is) All-Powerful"}], "sahih": "Many of the People of the Scripture wish they could turn you back to disbelief after you have believed, out of envy from themselves [even] after the truth has become clear to them. So pardon and overlook until Allāh delivers His command. Indeed, Allāh is over all things competent."}