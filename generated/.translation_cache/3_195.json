{"words": [{"text": "فَٱسْتَجَابَ", "translation": "Then responded"}, {"text": "لَهُمْ", "translation": "to them"}, {"text": "رَبُّهُمْ", "translation": "their Lord"}, {"text": "أَنِّى", "translation": "Indeed, I"}, {"text": "لَآ", "translation": "(will) not"}, {"text": "أُضِيعُ", "translation": "(let go) waste"}, {"text": "عَمَلَ", "translation": "deeds"}, {"text": "عَـٰمِلٍۢ", "translation": "(of the) doer"}, {"text": "مِّنكُم", "translation": "among you"}, {"text": "مِّن", "translation": "[from]"}, {"text": "ذَكَرٍ", "translation": "(whether) male"}, {"text": "أَوْ", "translation": "or"}, {"text": "أُنثَىٰ ۖ", "translation": "female"}, {"text": "بَعْضُكُم", "translation": "each of you"}, {"text": "مِّنۢ", "translation": "from"}, {"text": "بَعْضٍۢ ۖ", "translation": "(the) other"}, {"text": "فَٱلَّذِينَ", "translation": "So those who"}, {"text": "هَاجَرُوا۟", "translation": "emigrated"}, {"text": "وَأُخْرِجُوا۟", "translation": "and were driven out"}, {"text": "مِن", "translation": "from"}, {"text": "دِيَـٰرِهِمْ", "translation": "their homes"}, {"text": "وَأُوذُوا۟", "translation": "and were harmed"}, {"text": "فِى", "translation": "in"}, {"text": "سَبِيلِى", "translation": "My way"}, {"text": "وَقَـٰتَلُوا۟", "translation": "and fought"}, {"text": "وَقُتِلُوا۟", "translation": "and were killed "}, {"text": "لَأُكَفِّرَنَّ", "translation": "surely I (will) remove"}, {"text": "عَنْهُمْ", "translation": "from them"}, {"text": "سَيِّـَٔاتِهِمْ", "translation": "their evil deeds"}, {"text": "وَلَأُدْخِلَنَّهُمْ", "translation": "and surely I will admit them"}, {"text": "جَنَّـٰتٍۢ", "translation": "(to) Gardens"}, {"text": "تَجْرِى", "translation": "flowing"}, {"text": "مِن", "translation": "from"}, {"text": "تَحْتِهَا", "translation": "underneath them"}, {"text": "ٱلْأَنْهَـٰرُ", "translation": "the rivers "}, {"text": "ثَوَابًۭا", "translation": "a reward"}, {"text": "مِّنْ", "translation": "from"}, {"text": "عِندِ", "translation": "[near]"}, {"text": "ٱللَّهِ ۗ", "translation": "Allah"}, {"text": "وَٱللَّهُ", "translation": "And Allah "}, {"text": "عِندَهُۥ", "translation": "with Him"}, {"text": "حُسْنُ", "translation": "(is the) best"}, {"text": "ٱلثَّوَابِ", "translation": "reward"}], "sahih": "And their Lord responded to them, \"Never will I allow to be lost the work of [any] worker among you, whether male or female; you are of one another. So those who emigrated or were evicted from their homes or were harmed in My cause or fought or were killed - I will surely remove from them their misdeeds, and I will surely admit them to gardens beneath which rivers flow as reward from Allāh, and Allāh has with Him the best reward.\""}