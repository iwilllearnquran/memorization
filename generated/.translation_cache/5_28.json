{"words": [{"text": "لَئِنۢ", "translation": "If"}, {"text": "بَسَطتَ", "translation": "you stretch"}, {"text": "إِلَىَّ", "translation": "towards me"}, {"text": "يَدَكَ", "translation": "your hand"}, {"text": "لِتَقْتُلَنِى", "translation": "to kill me"}, {"text": "مَآ", "translation": "not"}, {"text": "أَنَا۠", "translation": "will I"}, {"text": "بِبَاسِطٍۢ", "translation": "stretch"}, {"text": "يَدِىَ", "translation": "my hand"}, {"text": "إِلَيْكَ", "translation": "towards you"}, {"text": "لِأَقْتُلَكَ ۖ", "translation": "to kill you"}, {"text": "إِنِّىٓ", "translation": "indeed I"}, {"text": "أَخَافُ", "translation": "fear"}, {"text": "ٱللَّهَ", "translation": "Allah"}, {"text": "رَبَّ", "translation": "(the) Lord"}, {"text": "ٱلْعَـٰلَمِينَ", "translation": "(of) the worlds"}], "sahih": "If you should raise your hand toward me to kill me - I shall not raise my hand toward you to kill you. Indeed, I fear Allāh, Lord of the worlds."}