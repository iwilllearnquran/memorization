{"words": [{"text": "مَّا", "translation": "(Do) not"}, {"text": "يَوَدُّ", "translation": "like"}, {"text": "ٱلَّذِينَ", "translation": "those who"}, {"text": "كَفَرُوا۟", "translation": "disbelieve"}, {"text": "مِنْ", "translation": "from"}, {"text": "أَهْلِ", "translation": "(the) People"}, {"text": "ٱلْكِتَـٰبِ", "translation": "(of) the Book"}, {"text": "وَلَا", "translation": "and not"}, {"text": "ٱلْمُشْرِكِينَ", "translation": "those who associate partners (with Allah)"}, {"text": "أَن", "translation": "that"}, {"text": "يُنَزَّلَ", "translation": "(there should) be sent down"}, {"text": "عَلَيْكُم", "translation": "to you"}, {"text": "مِّنْ", "translation": "any"}, {"text": "خَيْرٍۢ", "translation": "good"}, {"text": "مِّن", "translation": "from"}, {"text": "رَّبِّكُمْ ۗ", "translation": "your Lord"}, {"text": "وَٱللَّهُ", "translation": "And Allah"}, {"text": "يَخْتَصُّ", "translation": "chooses"}, {"text": "بِرَحْمَتِهِۦ", "translation": "for His Mercy"}, {"text": "مَن", "translation": "whom"}, {"text": "يَشَآءُ ۚ", "translation": "He wills"}, {"text": "وَٱللَّهُ", "translation": "And Allah"}, {"text": "ذُو", "translation": "(is the) Possessor"}, {"text": "ٱلْفَضْلِ", "translation": "(of) [the] Bounty"}, {"text": "ٱلْعَظِيمِ", "translation": "[the] Great"}], "sahih": "Neither those who disbelieve from the People of the Scripture [i.e., the Jews and Christians] nor the polytheists wish that any good should be sent down to you from your Lord. But Allāh selects for His mercy whom He wills, and Allāh is the possessor of great bounty."}