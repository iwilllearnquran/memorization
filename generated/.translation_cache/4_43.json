{"words": [{"text": "يَـٰٓأَيُّهَا", "translation": "O you"}, {"text": "ٱلَّذِينَ", "translation": "who"}, {"text": "ءَامَنُوا۟", "translation": "believe[d]"}, {"text": "لَا", "translation": "(Do) not"}, {"text": "تَقْرَبُوا۟", "translation": "go near"}, {"text": "ٱلصَّلَوٰةَ", "translation": "the prayer"}, {"text": "وَأَنتُمْ", "translation": "while you"}, {"text": "سُكَـٰرَىٰ", "translation": "(are) intoxicated"}, {"text": "حَتَّىٰ", "translation": "until"}, {"text": "تَعْلَمُوا۟", "translation": "you know"}, {"text": "مَا", "translation": "what"}, {"text": "تَقُولُونَ", "translation": "you are saying"}, {"text": "وَلَا", "translation": "and not"}, {"text": "جُنُبًا", "translation": "(when you are) impure"}, {"text": "إِلَّا", "translation": "except"}, {"text": "عَابِرِى", "translation": "(when) passing"}, {"text": "سَبِيلٍ", "translation": "(through) a way"}, {"text": "حَتَّىٰ", "translation": "until"}, {"text": "تَغْتَسِلُوا۟ ۚ", "translation": "you have bathed"}, {"text": "وَإِن", "translation": "And if"}, {"text": "كُنتُم", "translation": "you are"}, {"text": "مَّرْضَىٰٓ", "translation": "ill"}, {"text": "أَوْ", "translation": "or"}, {"text": "عَلَىٰ", "translation": "on"}, {"text": "سَفَرٍ", "translation": "a journey"}, {"text": "أَوْ", "translation": "or"}, {"text": "جَآءَ", "translation": "came"}, {"text": "أَحَدٌۭ", "translation": "one"}, {"text": "مِّنكُم", "translation": "of you"}, {"text": "مِّنَ", "translation": "from"}, {"text": "ٱلْغَآئِطِ", "translation": "the toilet"}, {"text": "أَوْ", "translation": "or"}, {"text": "لَـٰمَسْتُمُ", "translation": "you have touched"}, {"text": "ٱلنِّسَآءَ", "translation": "the women"}, {"text": "فَلَمْ", "translation": "and not"}, {"text": "تَجِدُوا۟", "translation": "you find"}, {"text": "مَآءًۭ", "translation": "water"}, {"text": "فَتَيَمَّمُوا۟", "translation": "then do tayammum"}, {"text": "صَعِيدًۭا", "translation": "(with) earth"}, {"text": "طَيِّبًۭا", "translation": "clean"}, {"text": "فَٱمْسَحُوا۟", "translation": "and wipe (with it)"}, {"text": "بِوُجُوهِكُمْ", "translation": "your faces"}, {"text": "وَأَيْدِيكُمْ ۗ", "translation": "and your hands"}, {"text": "إِنَّ", "translation": "Indeed"}, {"text": "ٱللَّهَ", "translation": "Allah"}, {"text": "كَانَ", "translation": "is"}, {"text": "عَفُوًّا", "translation": "Oft-Pardoning"}, {"text": "غَفُورًا", "translation": "Oft-Forgiving"}], "sahih": "O you who have believed, do not approach prayer while you are intoxicated until you know what you are saying1 or in a state of janābah,2 except those passing through [a place of prayer], until you have washed [your whole body]. And if you are ill or on a journey or one of you comes from the place of relieving himself or you have contacted women [i.e., had sexual intercourse] and find no water, then seek clean earth and wipe over your faces and your hands [with it]. Indeed, Allāh is ever Pardoning3 and Forgiving."}