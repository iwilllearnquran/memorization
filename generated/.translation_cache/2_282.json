{"words": [{"text": "يَـٰٓأَيُّهَا", "translation": "O you"}, {"text": "ٱلَّذِينَ", "translation": "who"}, {"text": "ءَامَنُوٓا۟", "translation": "believe[d]"}, {"text": "إِذَا", "translation": "When"}, {"text": "تَدَايَنتُم", "translation": "you contract with one another"}, {"text": "بِدَيْنٍ", "translation": "any debt"}, {"text": "إِلَىٰٓ", "translation": "for"}, {"text": "أَجَلٍۢ", "translation": "a term"}, {"text": "مُّسَمًّۭى", "translation": "fixed"}, {"text": "فَٱكْتُبُوهُ ۚ", "translation": "then write it"}, {"text": "وَلْيَكْتُب", "translation": "And let write"}, {"text": "بَّيْنَكُمْ", "translation": "between you"}, {"text": "كَاتِبٌۢ", "translation": "a scribe"}, {"text": "بِٱلْعَدْلِ ۚ", "translation": "in justice"}, {"text": "وَلَا", "translation": "And not"}, {"text": "يَأْبَ", "translation": "(should) refuse"}, {"text": "كَاتِبٌ", "translation": "a scribe"}, {"text": "أَن", "translation": "that"}, {"text": "يَكْتُبَ", "translation": "he writes"}, {"text": "كَمَا", "translation": "as"}, {"text": "عَلَّمَهُ", "translation": "(has) taught him"}, {"text": "ٱللَّهُ ۚ", "translation": "Allah"}, {"text": "فَلْيَكْتُبْ", "translation": "So let him write"}, {"text": "وَلْيُمْلِلِ", "translation": "and let dictate"}, {"text": "ٱلَّذِى", "translation": "the one"}, {"text": "عَلَيْهِ", "translation": "on whom"}, {"text": "ٱلْحَقُّ", "translation": "(is) the right"}, {"text": "وَلْيَتَّقِ", "translation": "and let him fear"}, {"text": "ٱللَّهَ", "translation": "Allah"}, {"text": "رَبَّهُۥ", "translation": "his Lord"}, {"text": "وَلَا", "translation": "and (let him) not"}, {"text": "يَبْخَسْ", "translation": "diminish"}, {"text": "مِنْهُ", "translation": "from it"}, {"text": "شَيْـًۭٔا ۚ", "translation": "anything"}, {"text": "فَإِن", "translation": "Then if"}, {"text": "كَانَ", "translation": "is"}, {"text": "ٱلَّذِى", "translation": "the one"}, {"text": "عَلَيْهِ", "translation": "on him"}, {"text": "ٱلْحَقُّ", "translation": "(is) the right"}, {"text": "سَفِيهًا", "translation": "(of) limited understanding"}, {"text": "أَوْ", "translation": "or"}, {"text": "ضَعِيفًا", "translation": "weak"}, {"text": "أَوْ", "translation": "or"}, {"text": "لَا", "translation": "not"}, {"text": "يَسْتَطِيعُ", "translation": "capable"}, {"text": "أَن", "translation": "that"}, {"text": "يُمِلَّ", "translation": "(can) dictate"}, {"text": "هُوَ", "translation": "he"}, {"text": "فَلْيُمْلِلْ", "translation": "then let dictate"}, {"text": "وَلِيُّهُۥ", "translation": "his guardian"}, {"text": "بِٱلْعَدْلِ ۚ", "translation": "with justice"}, {"text": "وَٱسْتَشْهِدُوا۟", "translation": "And call for evidence"}, {"text": "شَهِيدَيْنِ", "translation": "two witnesses"}, {"text": "مِن", "translation": "among"}, {"text": "رِّجَالِكُمْ ۖ", "translation": "your men"}, {"text": "فَإِن", "translation": "And if"}, {"text": "لَّمْ", "translation": "not"}, {"text": "يَكُونَا", "translation": "there are"}, {"text": "رَجُلَيْنِ", "translation": "two men"}, {"text": "فَرَجُلٌۭ", "translation": "then one man"}, {"text": "وَٱمْرَأَتَانِ", "translation": "and two women"}, {"text": "مِمَّن", "translation": "of whom"}, {"text": "تَرْضَوْنَ", "translation": "you agree"}, {"text": "مِنَ", "translation": "of"}, {"text": "ٱلشُّهَدَآءِ", "translation": "[the] witnesses"}, {"text": "أَن", "translation": "(so) that (if)"}, {"text": "تَضِلَّ", "translation": "[she] errs"}, {"text": "إِحْدَىٰهُمَا", "translation": "one of the two"}, {"text": "فَتُذَكِّرَ", "translation": "then will remind"}, {"text": "إِحْدَىٰهُمَا", "translation": "one of the two"}, {"text": "ٱلْأُخْرَىٰ ۚ", "translation": "the other"}, {"text": "وَلَا", "translation": "And not"}, {"text": "يَأْبَ", "translation": "(should) refuse"}, {"text": "ٱلشُّهَدَآءُ", "translation": "the witnesses"}, {"text": "إِذَا", "translation": "when"}, {"text": "مَا", "translation": "that"}, {"text": "دُعُوا۟ ۚ", "translation": "they are called"}, {"text": "وَلَا", "translation": "And not"}, {"text": "تَسْـَٔمُوٓا۟", "translation": "(be) weary"}, {"text": "أَن", "translation": "that"}, {"text": "تَكْتُبُوهُ", "translation": "you write it "}, {"text": "صَغِيرًا", "translation": "small"}, {"text": "أَوْ", "translation": "or"}, {"text": "كَبِيرًا", "translation": "large"}, {"text": "إِلَىٰٓ", "translation": "for"}, {"text": "أَجَلِهِۦ ۚ", "translation": "its term"}, {"text": "ذَٰلِكُمْ", "translation": "That"}, {"text": "أَقْسَطُ", "translation": "(is) more just"}, {"text": "عِندَ", "translation": "near"}, {"text": "ٱللَّهِ", "translation": "Allah"}, {"text": "وَأَقْوَمُ", "translation": "and more upright"}, {"text": "لِلشَّهَـٰدَةِ", "translation": "for evidence"}, {"text": "وَأَدْنَىٰٓ", "translation": "and nearer"}, {"text": "أَلَّا", "translation": "that not"}, {"text": "تَرْتَابُوٓا۟ ۖ", "translation": "you (have) doubt"}, {"text": "إِلَّآ", "translation": "except"}, {"text": "أَن", "translation": "that"}, {"text": "تَكُونَ", "translation": "be"}, {"text": "تِجَـٰرَةً", "translation": "a transaction"}, {"text": "حَاضِرَةًۭ", "translation": "present"}, {"text": "تُدِيرُونَهَا", "translation": "you carry out"}, {"text": "بَيْنَكُمْ", "translation": "among you"}, {"text": "فَلَيْسَ", "translation": "then not"}, {"text": "عَلَيْكُمْ", "translation": "on you"}, {"text": "جُنَاحٌ", "translation": "any sin"}, {"text": "أَلَّا", "translation": "that not"}, {"text": "تَكْتُبُوهَا ۗ", "translation": "you write it"}, {"text": "وَأَشْهِدُوٓا۟", "translation": "And take witness"}, {"text": "إِذَا", "translation": "when"}, {"text": "تَبَايَعْتُمْ ۚ", "translation": "you make commercial transaction"}, {"text": "وَلَا", "translation": "And not"}, {"text": "يُضَآرَّ", "translation": "(should) be harmed"}, {"text": "كَاتِبٌۭ", "translation": "(the) scribe"}, {"text": "وَلَا", "translation": "and not"}, {"text": "شَهِيدٌۭ ۚ", "translation": "(the) witness"}, {"text": "وَإِن", "translation": "and if"}, {"text": "تَفْعَلُوا۟", "translation": "you do"}, {"text": "فَإِنَّهُۥ", "translation": "then indeed it"}, {"text": "فُسُوقٌۢ", "translation": "(is) sinful conduct"}, {"text": "بِكُمْ ۗ", "translation": "for you"}, {"text": "وَٱتَّقُوا۟", "translation": "and fear"}, {"text": "ٱللَّهَ ۖ", "translation": "Allah"}, {"text": "وَيُعَلِّمُكُمُ", "translation": "And teaches"}, {"text": "ٱللَّهُ ۗ", "translation": "Allah"}, {"text": "وَٱللَّهُ", "translation": "And Allah"}, {"text": "بِكُلِّ", "translation": "of every"}, {"text": "شَىْءٍ", "translation": "thing"}, {"text": "عَلِيمٌۭ", "translation": "(is) All-Knower"}], "sahih": "O you who have believed, when you contract a debt for a specified term, write it down. And let a scribe write [it] between you in justice. Let no scribe refuse to write as Allāh has taught him. So let him write and let the one who has the obligation [i.e., the debtor] dictate. And let him fear Allāh, his Lord, and not leave anything out of it. But if the one who has the obligation is of limited understanding or weak or unable to dictate himself, then let his guardian dictate in justice. And bring to witness two witnesses from among your men. And if there are not two men [available], then a man and two women from those whom you accept as witnesses - so that if one of them [i.e., the women] errs, then the other can remind her. And let not the witnesses refuse when they are called upon. And do not be [too] weary to write it, whether it is small or large, for its [specified] term. That is more just in the sight of Allāh and stronger as evidence and more likely to prevent doubt between you, except when it is an immediate transaction which you conduct among yourselves. For [then] there is no blame upon you if you do not write it. And take witnesses when you conclude a contract. Let no scribe be harmed or any witness. For if you do so, indeed, it is [grave] disobedience in you. And fear Allāh. And Allāh teaches you. And Allāh is Knowing of all things."}