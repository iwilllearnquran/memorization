{"words": [{"text": "۞ مَا", "translation": "What"}, {"text": "نَنسَخْ", "translation": "We abrogate"}, {"text": "مِنْ", "translation": "(of)"}, {"text": "ءَايَةٍ", "translation": "a sign"}, {"text": "أَوْ", "translation": "or"}, {"text": "نُنسِهَا", "translation": "[We] cause it to be forgotten"}, {"text": "نَأْتِ", "translation": "We bring"}, {"text": "بِخَيْرٍۢ", "translation": "better"}, {"text": "مِّنْهَآ", "translation": "than it"}, {"text": "أَوْ", "translation": "or"}, {"text": "مِثْلِهَآ ۗ", "translation": "similar (to) it"}, {"text": "أَلَمْ", "translation": "Do not"}, {"text": "تَعْلَمْ", "translation": "you know"}, {"text": "أَنَّ", "translation": "that"}, {"text": "ٱللَّهَ", "translation": "Allah"}, {"text": "عَلَىٰ", "translation": "over"}, {"text": "كُلِّ", "translation": "every"}, {"text": "شَىْءٍۢ", "translation": "thing"}, {"text": "قَدِيرٌ", "translation": "(is) All-Powerful"}], "sahih": "We do not abrogate a verse or cause it to be forgotten except that We bring forth [one] better than it or similar to it. Do you not know that Allāh is over all things competent?"}