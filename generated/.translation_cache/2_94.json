{"words": [{"text": "قُلْ", "translation": "Say"}, {"text": "إِن", "translation": "If "}, {"text": "كَانَتْ", "translation": "is"}, {"text": "لَكُمُ", "translation": "for you"}, {"text": "ٱلدَّارُ", "translation": "the home"}, {"text": "ٱلْـَٔاخِرَةُ", "translation": "(of) the Hereafter"}, {"text": "عِندَ", "translation": "with"}, {"text": "ٱللَّهِ", "translation": "Allah"}, {"text": "خَالِصَةًۭ", "translation": "exclusively"}, {"text": "مِّن", "translation": "from"}, {"text": "دُونِ", "translation": "excluding"}, {"text": "ٱلنَّاسِ", "translation": "the mankind"}, {"text": "فَتَمَنَّوُا۟", "translation": "then wish"}, {"text": "ٱلْمَوْتَ", "translation": "(for) [the] death"}, {"text": "إِن", "translation": "if"}, {"text": "كُنتُمْ", "translation": "you are"}, {"text": "صَـٰدِقِينَ", "translation": "truthful"}], "sahih": "Say, [O Muḥammad], \"If the home of the Hereafter with Allāh is for you alone and not the [other] people, then wish for death, if you should be truthful.\""}