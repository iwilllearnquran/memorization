{"words": [{"text": "أَلَمْ", "translation": "Do not"}, {"text": "تَعْلَمْ", "translation": "you know"}, {"text": "أَنَّ", "translation": "that"}, {"text": "ٱللَّهَ", "translation": "Allah"}, {"text": "لَهُۥ", "translation": "for Him"}, {"text": "مُلْكُ", "translation": "(is the) Kingdom"}, {"text": "ٱلسَّمَـٰوَٰتِ", "translation": "(of) the heavens"}, {"text": "وَٱلْأَرْضِ ۗ", "translation": "and the earth"}, {"text": "وَمَا", "translation": "And not"}, {"text": "لَكُم", "translation": "(is) for you"}, {"text": "مِّن", "translation": "from"}, {"text": "دُونِ", "translation": "besides"}, {"text": "ٱللَّهِ", "translation": "Allah"}, {"text": "مِن", "translation": "any"}, {"text": "وَلِىٍّۢ", "translation": "protector"}, {"text": "وَلَا", "translation": "and not"}, {"text": "نَصِيرٍ", "translation": "any helper"}], "sahih": "Do you not know that to Allāh belongs the dominion of the heavens and the earth and [that] you have not besides Allāh any protector or any helper?"}