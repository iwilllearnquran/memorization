{"words": [{"text": "قُلْ", "translation": "Say"}, {"text": "هَلْ", "translation": "Shall"}, {"text": "أُنَبِّئُكُم", "translation": "I inform you"}, {"text": "بِشَرٍّۢ", "translation": "(of) worse"}, {"text": "مِّن", "translation": "than"}, {"text": "ذَٰلِكَ", "translation": "that"}, {"text": "مَثُوبَةً", "translation": "(as) recompense"}, {"text": "عِندَ", "translation": "from"}, {"text": "ٱللَّهِ ۚ", "translation": "Allah"}, {"text": "مَن", "translation": "Whom"}, {"text": "لَّعَنَهُ", "translation": "has (been) cursed"}, {"text": "ٱللَّهُ", "translation": "(by) Allah"}, {"text": "وَغَضِبَ", "translation": "and He became angry"}, {"text": "عَلَيْهِ", "translation": "with him"}, {"text": "وَجَعَلَ", "translation": "and made"}, {"text": "مِنْهُمُ", "translation": "of them"}, {"text": "ٱلْقِرَدَةَ", "translation": "[the] apes"}, {"text": "وَٱلْخَنَازِيرَ", "translation": "and [the] swines"}, {"text": "وَعَبَدَ", "translation": "and (who) worshipped"}, {"text": "ٱلطَّـٰغُوتَ ۚ", "translation": "the false deities"}, {"text": "أُو۟لَـٰٓئِكَ", "translation": "Those"}, {"text": "شَرٌّۭ", "translation": "(are) worse"}, {"text": "مَّكَانًۭا", "translation": "(in) position"}, {"text": "وَأَضَلُّ", "translation": "and farthest astray"}, {"text": "عَن", "translation": "from"}, {"text": "سَوَآءِ", "translation": "(the) even"}, {"text": "ٱلسَّبِيلِ", "translation": "way"}], "sahih": "Say, \"Shall I inform you of [what is] worse than that1 as penalty from Allāh? [It is that of] those whom Allāh has cursed and with whom He became angry and made of them apes and pigs and slaves of ṭāghūt.2 Those are worse in position and further astray from the sound way.\""}