{"words": [{"text": "يَـٰبَنِىٓ", "translation": "O Children"}, {"text": "إِسْرَٰٓءِيلَ", "translation": "(of) Israel"}, {"text": "ٱذْكُرُوا۟", "translation": "Remember"}, {"text": "نِعْمَتِىَ", "translation": "My Favor"}, {"text": "ٱلَّتِىٓ", "translation": "which"}, {"text": "أَنْعَمْتُ", "translation": "I bestowed"}, {"text": "عَلَيْكُمْ", "translation": "upon you"}, {"text": "وَأَنِّى", "translation": "and that I"}, {"text": "فَضَّلْتُكُمْ", "translation": "[I] preferred you"}, {"text": "عَلَى", "translation": "over"}, {"text": "ٱلْعَـٰلَمِينَ", "translation": "the worlds"}], "sahih": "O Children of Israel, remember My favor that I have bestowed upon you and that I preferred you over the worlds [i.e., peoples]."}