{"words": [{"text": "۞ وَٱعْبُدُوا۟", "translation": "And worship"}, {"text": "ٱللَّهَ", "translation": "Allah"}, {"text": "وَلَا", "translation": "And (do) not"}, {"text": "تُشْرِكُوا۟", "translation": "associate"}, {"text": "بِهِۦ", "translation": "with Him"}, {"text": "شَيْـًۭٔا ۖ", "translation": "anything"}, {"text": "وَبِٱلْوَٰلِدَيْنِ", "translation": "and to the parents"}, {"text": "إِحْسَـٰنًۭا", "translation": "(do) good"}, {"text": "وَبِذِى", "translation": "and with"}, {"text": "ٱلْقُرْبَىٰ", "translation": "the relatives"}, {"text": "وَٱلْيَتَـٰمَىٰ", "translation": "and the orphans"}, {"text": "وَٱلْمَسَـٰكِينِ", "translation": "and the needy"}, {"text": "وَٱلْجَارِ", "translation": "and the neighbor"}, {"text": "ذِى", "translation": "(who is)"}, {"text": "ٱلْقُرْبَىٰ", "translation": "near"}, {"text": "وَٱلْجَارِ", "translation": "and the neighbor"}, {"text": "ٱلْجُنُبِ", "translation": "(who is) farther away"}, {"text": "وَٱلصَّاحِبِ", "translation": "and the companion"}, {"text": "بِٱلْجَنۢبِ", "translation": "by your side"}, {"text": "وَٱبْنِ", "translation": "and the"}, {"text": "ٱلسَّبِيلِ", "translation": "traveler"}, {"text": "وَمَا", "translation": "and what"}, {"text": "مَلَكَتْ", "translation": "possess[ed]"}, {"text": "أَيْمَـٰنُكُمْ ۗ", "translation": "your right hands"}, {"text": "إِنَّ", "translation": "Indeed"}, {"text": "ٱللَّهَ", "translation": "Allah"}, {"text": "لَا", "translation": "(does) not"}, {"text": "يُحِبُّ", "translation": "love"}, {"text": "مَن", "translation": "(the one) who"}, {"text": "كَانَ", "translation": "is"}, {"text": "مُخْتَالًۭا", "translation": "[a] proud"}, {"text": "فَخُورًا", "translation": "(and) [a] boastful"}], "sahih": "Worship Allāh and associate nothing with Him, and to parents do good, and to relatives, orphans, the needy, the near neighbor, the neighbor farther away, the companion at your side,1 the traveler, and those whom your right hands possess. Indeed, Allāh does not like those who are self-deluding and boastful,"}