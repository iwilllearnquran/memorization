{
  "93:1": [
    {
      "ar": "وَٱلضُّحَىٰ",
      "en": "By the morning brightness"
    }
  ],
  "93:2": [
    {
      "ar": "وَٱلَّيْلِ",
      "en": "And the night"
    },
    {
      "ar": "إِذَا",
      "en": "when"
    },
    {
      "ar": "سَجَىٰ",
      "en": "it covers with darkness"
    }
  ],
  "93:3": [
    {
      "ar": "مَا",
      "en": "Not"
    },
    {
      "ar": "وَدَّعَكَ",
      "en": "has forsaken you"
    },
    {
      "ar": "رَبُّكَ",
      "en": "your Lord"
    },
    {
      "ar": "وَمَا",
      "en": "and not"
    },
    {
      "ar": "قَلَىٰ",
      "en": "He is displeased"
    }
  ],
  "93:4": [
    {
      "ar": "وَلَلْـَٔاخِرَةُ",
      "en": "And surely the Hereafter"
    },
    {
      "ar": "خَيْرٌۭ",
      "en": "(is) better"
    },
    {
      "ar": "لَّكَ",
      "en": "for you"
    },
    {
      "ar": "مِنَ",
      "en": "than"
    },
    {
      "ar": "ٱلْأُولَىٰ",
      "en": "the first"
    }
  ],
  "93:5": [
    {
      "ar": "وَلَسَوْفَ",
      "en": "And soon"
    },
    {
      "ar": "يُعْطِيكَ",
      "en": "will give you"
    },
    {
      "ar": "رَبُّكَ",
      "en": "your Lord"
    },
    {
      "ar": "فَتَرْضَىٰٓ",
      "en": "then you will be satisfied"
    }
  ],
  "93:6": [
    {
      "ar": "أَلَمْ",
      "en": "Did not"
    },
    {
      "ar": "يَجِدْكَ",
      "en": "He find you"
    },
    {
      "ar": "يَتِيمًۭا",
      "en": "an orphan"
    },
    {
      "ar": "فَـَٔاوَىٰ",
      "en": "and give shelter"
    }
  ],
  "93:7": [
    {
      "ar": "وَوَجَدَكَ",
      "en": "And He found you"
    },
    {
      "ar": "ضَآلًّۭا",
      "en": "lost"
    },
    {
      "ar": "فَهَدَىٰ",
      "en": "so He guided"
    }
  ],
  "93:8": [
    {
      "ar": "وَوَجَدَكَ",
      "en": "And He found you"
    },
    {
      "ar": "عَآئِلًۭا",
      "en": "in need"
    },
    {
      "ar": "فَأَغْنَىٰ",
      "en": "so He made self-sufficient"
    }
  ],
  "93:9": [
    {
      "ar": "فَأَمَّا",
      "en": "So as for"
    },
    {
      "ar": "ٱلْيَتِيمَ",
      "en": "the orphan"
    },
    {
      "ar": "فَلَا",
      "en": "then (do) not"
    },
    {
      "ar": "تَقْهَرْ",
      "en": "oppress"
    }
  ],
  "93:10": [
    {
      "ar": "وَأَمَّا",
      "en": "And as for"
    },
    {
      "ar": "ٱلسَّآئِلَ",
      "en": "one who asks"
    },
    {
      "ar": "فَلَا",
      "en": "then (do) not"
    },
    {
      "ar": "تَنْهَرْ",
      "en": "repel"
    }
  ],
  "93:11": [
    {
      "ar": "وَأَمَّا",
      "en": "But as for"
    },
    {
      "ar": "بِنِعْمَةِ",
      "en": "(the) Favor"
    },
    {
      "ar": "رَبِّكَ",
      "en": "(of) your Lord"
    },
    {
      "ar": "فَحَدِّثْ",
      "en": "narrate"
    }
  ]
}