{
  "hosting": {
    "public": ".",
    "redirects": [
      {
        "source": "/duas",
        "destination": "/?tab=duas",
        "type": 301
      },
      {
        "source": "/duas/",
        "destination": "/?tab=duas",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      "**/.git/**"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
